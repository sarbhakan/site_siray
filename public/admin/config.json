{
  "$schema": "https://unpkg.com/@sveltia/cms@0.270.0/schema/sveltia-cms.json",
  "app_title": "Siray Signature — modifier le site",
  "site_url": "https://siraysignature.fr",
  "display_url": "https://siraysignature.fr",
  "backend": {
    "name": "github",
    "repo": "sarbhakan/site_siray",
    "branch": "main",
    "base_url": "https://siray-cms-auth.mr-hakan336.workers.dev",
    "auth_methods": [
      "oauth"
    ]
  },
  "publish_mode": "simple",
  "media_folder": "/src/assets/uploads",
  "public_folder": "/src/assets/uploads",
  "media_libraries": {
    "all": {
      "max_file_size": 20971520,
      "slugify_filename": true,
      "filename_template": "{{year}}{{month}}{{day}}-{{uuid_short}}",
      "transformations": {
        "raster_image": {
          "format": "webp",
          "quality": 94,
          "width": 2560,
          "height": 2560
        }
      }
    }
  },
  "asset_collections": [
    {
      "name": "photos-actuelles",
      "label": "Photos actuelles du site",
      "media_folder": "/public/images",
      "public_folder": "/images",
      "readonly": true
    }
  ],
