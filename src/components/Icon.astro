---
interface Props {
  name?:
    'arrow' | 'diagonal' | 'close' | 'plus' | 'instagram' | 'pause' | 'play';
  class?: string;
}
const { name = 'arrow', class: className } = Astro.props;
---

<svg
  class={className}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'arrow' && (
    <>
      <path d="M4 12h15M13 6l6 6-6 6" />
    </>
  )}
  {name === 'diagonal' && (
    <>
      <path d="M5 19 19 5M5 5h14v14" />
    </>
  )}
  {name === 'close' && <path d="m5 5 14 14M19 5 5 19" />}
  {name === 'plus' && <path d="M12 4v16M4 12h16" />}
  {name === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r=".6" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'pause' && <path d="M9 5v14M15 5v14" />}
  {name === 'play' && <path d="m9 5 11 7-11 7Z" />}
</svg>
