---
import { mignardiseMenu as menu } from '../data/site';
const preview = Boolean((Astro.locals as { sirayPreviewPath?: string }).sirayPreviewPath);
const savory = menu.savory.length || !preview ? menu.savory : [{ name: '', detail: '' }];
---

<div class="mignardise-menu">
  <section aria-labelledby="coin-gourmand">
    <h2 id="coin-gourmand" data-preview-text="catalog.mignardiseMenu.savoryTitle">{menu.savoryTitle}</h2>
    <p class="mignardise-intro" data-preview-text="catalog.mignardiseMenu.savoryIntro">{menu.savoryIntro}</p>
    <ul class="mignardise-savory" data-preview-each="catalog.mignardiseMenu.savory">
      {savory.map((choice) => <li hidden={menu.savory.length === 0}><h3 data-preview-text=".name">{choice.name}</h3><p hidden={!choice.detail} data-preview-visible=".detail" data-preview-text=".detail">{choice.detail}</p></li>)}
    </ul>
    <p class="mignardise-finale" data-preview-text="catalog.mignardiseMenu.savoryFinale">{menu.savoryFinale}</p>
  </section>
  <section class="mignardise-sweet" aria-labelledby="touche-sucree">
    <h2 id="touche-sucree" data-preview-text="catalog.mignardiseMenu.sweetTitle">{menu.sweetTitle}</h2>
    <p data-preview-text="catalog.mignardiseMenu.sweetText">{menu.sweetText}</p>
  </section>
</div>

<style>
  .mignardise-menu h2 { font-size: 26px; line-height: 1.25; }
  .mignardise-menu p { max-width: none; font-size: 16px; line-height: 1.625; }
  .mignardise-intro { margin-top: 12px; color: var(--muted); }
  .mignardise-savory { margin-top: 24px; list-style: none; }
  .mignardise-savory > li { padding-block: 14px; border-top: 1px solid var(--line); }
  .mignardise-savory h3 { font: 600 16px/1.5 'Manrope', sans-serif; }
  .mignardise-savory p { margin: 4px 0 0; color: var(--muted); font-size: 16px; line-height: 1.625; }
  .mignardise-finale { margin-top: 12px; color: var(--muted); }
  .mignardise-sweet { margin-top: 32px; padding-block: 24px; border-top: 1px solid var(--olive-line); border-bottom: 1px solid var(--olive-line); }
  .mignardise-sweet p { margin-top: 12px; }
  @media (min-width: 960px) {
    .mignardise-menu h2 { font-size: 28px; }
  }
</style>
