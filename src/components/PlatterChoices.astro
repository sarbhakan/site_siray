---
import type { Tariff } from '../data/site';

interface Props { tariffs: Tariff[] }
const { tariffs } = Astro.props;
const euro = (price: number) => new Intl.NumberFormat('fr-FR', {
  style: 'currency', currency: 'EUR', maximumFractionDigits: 0,
}).format(price);
---

<div class="platter-choices">
  {tariffs.map((tariff) => (
    <details name="plateaux" class="platter-choice">
      <summary>
        <span class="platter-name">{tariff.label}</span>
        <span class="platter-price">{euro(tariff.price)}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
      </summary>
      <div class="platter-description"><p>{tariff.description || tariff.detail}</p></div>
    </details>
  ))}
</div>

<style>
  .platter-choice { border-top: 1px solid var(--line); }
  .platter-choice:last-child { border-bottom: 1px solid var(--line); }
  .platter-choice summary { display: grid; grid-template-columns: minmax(0, 1fr) auto 18px; align-items: center; gap: 12px; min-height: 72px; padding: 16px 4px; list-style: none; cursor: pointer; }
  .platter-choice summary::-webkit-details-marker { display: none; }
  .platter-name { font-size: 16px; font-weight: 600; line-height: 1.5; }
  .platter-price { font-size: 16px; font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .platter-choice summary svg { width: 18px; height: 18px; transition: transform 160ms var(--ease); }
  .platter-choice[open] summary svg { transform: rotate(180deg); }
  .platter-choice[open] summary { color: var(--olive-raised); }
  .platter-description { padding: 0 4px 20px; }
  .platter-description p { max-width: none; font-size: 16px; line-height: 1.625; color: var(--muted); }
  .platter-choice summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  @media (hover: hover) { .platter-choice summary:hover .platter-name { text-decoration: underline; text-underline-offset: 5px; } }
  @media (prefers-reduced-motion: reduce) { .platter-choice summary svg { transition: none; } }
  @media print { .platter-choice:not([open]) > .platter-description { display: block; } }
</style>
