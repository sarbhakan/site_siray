---
import type { ExtraSection } from '../data/site';

interface Props { sections: ExtraSection[]; slug: string }
const { sections, slug } = Astro.props;
const preview = (Astro.locals as { sirayPreviewPath?: string }).sirayPreviewPath;
const renderSections = sections.length ? sections : preview ? [{ title: '', text: '', items: [''], button: { label: '', href: '/' } }] : [];
---

<div class="extra-sections" data-preview-each={`catalog.collections.${slug}.extraSections`}>
{renderSections.map((section, index) => (
  <section id={`extra-${index}`} class="v5-product-panel extra-section" data-v5-panel aria-labelledby={`extra-heading-${index}`} hidden={sections.length === 0} data-preview-attr-id=".panelId" data-preview-attr-aria-labelledby=".headingId">
    <h2 id={`extra-heading-${index}`} data-preview-attr-id=".headingId" data-preview-text=".title">{section.title}</h2>
    <p class="extra-section-text" data-preview-text=".text">{section.text}</p>
    {(section.items?.length || preview) && <ul data-preview-each=".items" data-preview-visible=".items" hidden={!section.items?.length}>{(section.items?.length ? section.items : ['']).map((item) => <li data-preview-text=".">{item}</li>)}</ul>}
    {(section.button || preview) && <a class="round-link" href={section.button?.href || '/'} data-preview-text=".button.label" data-preview-attr-href=".button.href" data-preview-visible=".button.label" hidden={!section.button?.label}>{section.button?.label || (preview ? 'Bouton de la rubrique à compléter' : '')}</a>}
  </section>
))}
</div>

<style>
  .extra-sections { display: contents; }
  .extra-section { min-width: 0; padding-block: 8px 28px; border-top: 1px solid var(--line); padding-top: 32px; scroll-margin-top: var(--header-offset, 128px); overflow-wrap: anywhere; }
  .extra-section h2 { font-size: 26px; line-height: 1.25; }
  .extra-section-text { max-width: none; margin-top: 12px; color: var(--muted); font-size: 16px; line-height: 1.625; white-space: pre-line; }
  .extra-section ul { list-style: none; margin-top: 24px; }
  .extra-section li { padding-block: 12px; border-top: 1px solid var(--line); font-size: 16px; line-height: 1.625; }
  .extra-section .round-link { margin-top: 24px; max-width: 100%; text-align: center; white-space: normal; }
  :global(.v5-product-explorer.is-ready) .extra-section { padding-top: 0; border-top: 0; }
  :global(.v5-product-explorer.is-ready) .extra-section:not([hidden]) { animation: extra-section-reveal 180ms var(--ease); }
  .extra-section[hidden] { display: none !important; }
  @keyframes extra-section-reveal { from { opacity: .35; } to { opacity: 1; } }
  @media (min-width: 960px) { .extra-section h2 { font-size: 28px; } }
  @media (max-width: 359px) { .extra-section h2 { font-size: 24px; } }
  @media (prefers-reduced-motion: reduce) { :global(.v5-product-explorer.is-ready) .extra-section:not([hidden]) { animation: none; } }
  @media print { .extra-section[hidden] { display: block !important; } }
</style>
