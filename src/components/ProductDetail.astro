---
import Layout from '../layouts/Layout.astro';
import Photo from './Photo.astro';
import { collectionPhotography } from '../data/photography';
import PlatterChoices from './PlatterChoices.astro';
import BuffetService from './BuffetService.astro';
import MignardiseMenu from './MignardiseMenu.astro';
import ExtraSections from './ExtraSections.astro';
import {
  collections, instagram, classicFlavorGroups, signatureFlavors,
  cupcakeFlavorGroups, brunchBoxes, brunchPriceGroups, countInFrench, capitalize, type Collection,
} from '../data/site';

interface Props { item: Collection }
const { item } = Astro.props;
const preview = Boolean((Astro.locals as { sirayPreviewPath?: string }).sirayPreviewPath);
const seed = <T,>(values: T[], fallback: T): T[] => values.length || !preview ? values : [fallback];
const classic = ['layer-cakes', 'bento-cakes'].includes(item.slug);
const brunch = item.slug === 'brunch-box';
const layer = item.slug === 'layer-cakes';
const cupcakes = item.slug === 'cupcakes';
const buffet = item.slug === 'buffets';
const platters = item.slug === 'plateaux';
const mignardises = item.slug === 'mignardises';
const related = collections.filter((other) => other.slug !== item.slug).slice(0, 3);
const euro = (value: number) => new Intl.NumberFormat('fr-FR', {
  style: 'currency', currency: 'EUR', minimumFractionDigits: 0, maximumFractionDigits: 2,
}).format(value);
const formatLabel = brunch ? 'Les compositions' : classic ? 'Format & décor'
  : buffet ? 'La prestation' : 'Formats & tarifs';
const firstPanel = brunch ? 'compositions' : 'formats';
const extraSections = item.extraSections ?? [];
const tabs = [
  { id: firstPanel, label: formatLabel },
  ...(classic || cupcakes ? [{ id: 'saveurs', label: classic ? 'Saveurs classiques' : 'Les saveurs' }] : []),
  ...(layer ? [{ id: 'signatures', label: 'Associations Signature' }] : []),
  ...(mignardises ? [{ id: 'les-bouchees', label: 'Les bouchées' }] : []),
  ...extraSections.map((section, index) => ({ id: `extra-${index}`, label: section.title })),
  { id: 'votre-demande', label: buffet ? 'Demander un devis' : 'Préparer ma demande' },
];
const detailPhoto = collectionPhotography[item.slug].detail;
const flavorImages = [
  { name: 'fruits', alt: 'Fraises, myrtilles et oranges' },
  { name: 'chocolat', alt: 'Chocolat noir, blanc et au lait' },
  { name: 'notes-gourmandes', alt: 'Pistaches dans un bol' },
];
const flavorGroups = cupcakes ? cupcakeFlavorGroups : classicFlavorGroups;
const flavorCount = flavorGroups.reduce((total, group) => total + group.flavors.length, 0);
---

<Layout title={item.name} image={item.image} description={`${item.name} sur commande à Bordeaux et en Gironde. ${item.intro}`}>
  <article class="v5-product section-pad" data-preview-product={item.slug}>
    <nav class="breadcrumbs" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span>/</span><a href="/creations/">Nos prestations</a><span>/</span><span aria-current="page" data-preview-text={`catalog.collections.${item.slug}.name`}>{item.name}</span>
    </nav>

    <header class="v5-product-heading">
      <h1 data-preview-text={`catalog.collections.${item.slug}.name`}>{item.name}</h1>
      <div>
        <p class="v5-product-intro" data-preview-text={`catalog.collections.${item.slug}.intro`}>{item.intro}</p>
        {brunch ? (
          <p class="v5-product-price" data-preview-each="catalog.brunchPriceGroups">{brunchPriceGroups.map((group) => <span><span data-preview-text=".label">{group.label}</span> à <strong data-preview-text=".pricePerPerson">{euro(group.price)} / personne</strong></span>)}</p>
        ) : <p class="v5-product-price" data-preview-text={`catalog.collections.${item.slug}.priceSummary`}>{item.priceSummary}</p>}
      </div>
    </header>

    <div class="v5-product-studio">
      <aside class="v5-product-media" aria-label="Inspirations photographiques">
        <div class="v5-photo-composition">
          <div class="v5-product-photo"><Photo previewKey={`photography.collections.${item.slug}.cover`} name={item.image} alt={item.alt} position={item.position} zoom={item.zoom} eager sizes="(min-width: 960px) 42vw, 100vw" /></div>
          <div class="v5-detail-photo"><Photo previewKey={`photography.collections.${item.slug}.detail`} name={detailPhoto.image} alt={detailPhoto.alt} position={detailPhoto.position} zoom={detailPhoto.zoom} sizes="(min-width: 960px) 18vw, 35vw" /></div>
        </div>
      </aside>

      <div class="v5-product-explorer" data-v5-tabset>
        <nav class="v5-product-tabs" data-v5-tablist data-preview-each={`catalog.collections.${item.slug}.previewTabs`} hidden aria-label={`Découvrir les ${item.name.toLowerCase()}`}>
          {tabs.map((tab) => <button type="button" id={`volet-${tab.id}`} data-v5-tab={tab.id} data-preview-attr-id=".buttonId" data-preview-attr-data-v5-tab=".id" data-preview-text=".label">{tab.label}</button>)}
        </nav>

        <div class="v5-product-panels">
          <section id={firstPanel} class="v5-product-panel" data-v5-panel>
            {brunch ? (
              <>
                <span id="formats"></span>
                <div class="v5-panel-heading"><h2 data-preview-text="catalog.brunchHeading">{capitalize(countInFrench(brunchBoxes.length))} {brunchBoxes.length === 1 ? 'brunch' : 'brunchs'} au choix</h2><p>Du sucré, du salé et un jus de fruits dans chaque composition.</p></div>
                <div class="v5-brunch" data-v5-brunch>
                  <div class="v5-brunch-picker" data-v5-brunch-controls hidden>
                    <label for="brunch-composition">Choisissez une composition</label>
                    <div class="v5-brunch-select"><select id="brunch-composition" data-v5-brunch-select data-preview-each="catalog.brunchBoxes" aria-controls="brunch-details">
                      {brunchBoxes.map((box, index) => <option value={index} data-preview-attr-value=".index" data-preview-text=".optionLabel">{box.name} — {euro(box.price)} / personne</option>)}
                    </select></div>
                    <div class="v5-brunch-buttons" data-preview-each="catalog.brunchBoxes" role="group" aria-label="Choisissez une composition">
                      {brunchBoxes.map((box, index) => <button type="button" data-v5-box-choice={index} data-preview-attr-data-v5-box-choice=".index"><span data-preview-text=".name">{box.name}</span><span><span data-preview-text=".priceLabel">{euro(box.price)}</span><small>/ personne</small></span></button>)}
                    </div>
                    <p class="sr-only" data-v5-brunch-status role="status"></p>
                  </div>
                  <div id="brunch-details" class="v5-brunch-details" data-preview-each="catalog.brunchBoxes">
                    {brunchBoxes.map((box, index) => (
                      <section class="v5-box-composition" data-v5-box={index} aria-labelledby={`brunch-${index}`} data-preview-attr-data-v5-box=".index" data-preview-attr-aria-labelledby=".headingId">
                        <header><h3 id={`brunch-${index}`} data-preview-attr-id=".headingId" data-preview-text=".name">{box.name}</h3><p><strong data-preview-text=".priceLabel">{euro(box.price)}</strong> / personne</p></header>
                        <div class="v5-box-menu"><div><h4>Le sucré</h4><ul data-preview-each=".sweet">{seed(box.sweet, '').map((food) => <li hidden={box.sweet.length === 0} data-preview-text=".">{food}</li>)}</ul></div><div><h4>Le salé</h4><ul data-preview-each=".savory">{seed(box.savory, '').map((food) => <li hidden={box.savory.length === 0} data-preview-text=".">{food}</li>)}</ul></div><div class="v5-box-drink"><h4>La boisson</h4><p data-preview-text=".drink">{box.drink}</p></div></div>
                      </section>
                    ))}
                  </div>
                </div>
                <p class="v5-panel-note" data-preview-text={`catalog.collections.${item.slug}.panelNote`}>{item.panelNote}</p>
              </>
            ) : (
              <>
                <div class="v5-panel-heading"><h2>{classic ? 'Le format, puis votre décor' : buffet ? 'Mise en place du buffet' : platters ? 'Les plateaux à partager' : 'Les formats & leurs tarifs'}</h2><p data-preview-text={platters ? undefined : `catalog.collections.${item.slug}.text`}>{platters ? 'Découvrez la composition de chaque plateau.' : item.text}</p></div>
                {buffet && <BuffetService />}
                {platters && <PlatterChoices tariffs={item.tariffs} />}
                {!platters && (item.tariffs.length > 0 || (Astro.locals as { sirayPreviewPath?: string }).sirayPreviewPath) && (
                  <table class="v5-product-prices" hidden={item.tariffs.length === 0} data-preview-visible={`catalog.collections.${item.slug}.tariffs`}>
                    <caption class="sr-only">Les tarifs des {item.name.toLowerCase()}</caption>
                    <thead><tr><th scope="col">{item.slug === 'plateaux' ? 'Plateau' : 'Quantité'}</th><th scope="col">Tarif</th></tr></thead>
                    <tbody data-preview-each={`catalog.collections.${item.slug}.tariffs`}>{(item.tariffs.length ? item.tariffs : [{ label: '', price: 0, detail: '' }]).map((tariff) => <tr><th scope="row"><span data-preview-text=".label">{tariff.label}</span><small hidden={!tariff.detail} data-preview-visible=".detail" data-preview-text=".detail">{tariff.detail}</small></th><td data-preview-text=".priceLabel">{euro(tariff.price)}</td></tr>)}</tbody>
                  </table>
                )}
                {!buffet && !platters && <ul class="v5-product-options" data-preview-each={`catalog.collections.${item.slug}.previewPossibilities`}>{seed(item.possibilities, '').map((possibility, index) => <li hidden={item.possibilities.length === 0} data-preview-text=".text" data-preview-first-strong>{index === 0 ? <strong>{possibility}</strong> : possibility}</li>)}</ul>}
                <p class="v5-panel-note" data-preview-text={`catalog.collections.${item.slug}.panelNote`}>{item.panelNote}</p>
              </>
            )}
          </section>

          {(classic || cupcakes) && (
            <section id="saveurs" class="v5-product-panel" data-v5-panel>
              <div class="v5-panel-heading"><h2 data-preview-text={`catalog.collections.${item.slug}.flavorHeading`}>{capitalize(countInFrench(flavorCount))} {flavorCount === 1 ? 'saveur' : 'saveurs'} {cupcakes ? 'à découvrir' : flavorCount === 1 ? 'classique' : 'classiques'}</h2><p>Choisissez une famille pour retrouver ses saveurs.</p></div>
              <div class="v6-flavor-explorer" data-v6-flavors>
                <nav class="v6-flavor-tabs" data-v6-flavor-controls hidden aria-label="Familles de saveurs">
                  {flavorGroups.map((group, index) => <button type="button" id={`${item.slug}-famille-${index}`} data-v6-flavor-choice={`${item.slug}-saveur-${index}`} data-preview-text={`catalog.collections.${item.slug}.flavorGroups.${index}.name`}>{group.name}</button>)}
                </nav>
                {flavorGroups.map((group, index) => <section id={`${item.slug}-saveur-${index}`} class="v6-flavor-group" data-v6-flavor-panel>
                  <h3 data-preview-text={`catalog.collections.${item.slug}.flavorGroups.${index}.name`}>{group.name}</h3>
                  <div class="v6-flavor-photo"><Photo name={flavorImages[index].name} alt={flavorImages[index].alt} sizes="(min-width: 960px) 45vw, 100vw" /></div>
                  <ul data-preview-each={`catalog.collections.${item.slug}.flavorGroups.${index}.flavors`}>{seed(group.flavors, '').map((flavor) => <li hidden={group.flavors.length === 0} data-preview-text=".">{flavor}</li>)}</ul>
                </section>)}
              </div>
              {classic && <p class="v5-panel-note v6-supplement"><strong>Mélange de saveurs : supplément.</strong></p>}
            </section>
          )}

          {layer && (
            <section id="signatures" class="v5-product-panel" data-v5-panel>
              <div class="v5-panel-heading"><h2>Les associations Signature</h2><p data-preview-text="catalog.signatureHeading">{capitalize(countInFrench(signatureFlavors.length))} {signatureFlavors.length === 1 ? 'composition réservée' : 'compositions réservées'} aux layer cakes.</p></div>
              <dl class="v6-signature-menu" data-preview-each="catalog.signatureFlavors">{seed(signatureFlavors, { name: '', composition: '' }).map((flavor) => <div hidden={signatureFlavors.length === 0}><dt data-preview-text=".name">{flavor.name}</dt><dd data-preview-text=".composition">{flavor.composition}</dd></div>)}</dl>
            </section>
          )}

          {mignardises && (
            <section id="les-bouchees" class="v5-product-panel" data-v5-panel>
              <MignardiseMenu />
            </section>
          )}

          <ExtraSections sections={extraSections} slug={item.slug} />

          <section id="votre-demande" class="v5-product-panel" data-v5-panel>
            <div class="v5-panel-heading"><h2>{buffet ? 'Votre demande de devis' : 'Les détails à nous partager'}</h2><p>{buffet ? 'Partagez ces informations sur Instagram pour établir votre devis.' : 'Partagez ces détails sur Instagram.'}</p></div>
            <div class="v5-request-plan"><ul data-preview-each={`catalog.collections.${item.slug}.orderFields`}>{seed(item.orderFields, '').map((field) => <li hidden={item.orderFields.length === 0} data-preview-text=".">{field}</li>)}</ul></div>
            <p class="v5-order-note">Les tarifs peuvent varier selon les personnalisations. Un devis est établi si nécessaire.</p>
          </section>
        </div>

        <div class="v5-studio-contact">
          <a class="round-link" href={instagram} target="_blank" rel="noopener noreferrer">Écrire sur Instagram</a>
          <div class="v5-studio-practical"><p><strong>Sur commande</strong><span aria-hidden="true"> · </span><strong>Toutes nos viandes sont halal</strong></p><a href="/contact/#allergies">Allergies & intolérances</a></div>
        </div>
      </div>
    </div>

    <nav class="v5-related" aria-label="Poursuivre la découverte">
      <div class="v5-related-heading"><h2>À découvrir aussi</h2><a href="/creations/">Toutes les prestations</a></div>
      <div class="v5-related-grid">{related.map((other) => {
        const relatedPhoto = collectionPhotography[other.slug].request;
        return <a class="v5-related-link" href={other.href}><span class="v5-related-photo"><Photo previewKey={`photography.collections.${other.slug}.request`} name={relatedPhoto.image} alt={relatedPhoto.alt} sizes="(min-width: 960px) 30vw, (min-width: 600px) 28vw, 30vw" position={relatedPhoto.position} zoom={relatedPhoto.zoom} /></span><span data-preview-text={`catalog.collections.${other.slug}.name`}>{other.name}</span><span class="v5-related-action">Découvrir</span></a>;
      })}</div>
    </nav>
  </article>
</Layout>

<script>
  import '../scripts/product-explorer';
</script>

<style>
  .v5-product { padding-bottom: 48px; }
  .v5-product-heading { display: grid; gap: 16px; padding-block: 8px 28px; }
  .v5-product-heading h1 { font-size: var(--title-size); line-height: 1.14; }
  .v5-product-intro { max-width: none; font-size: 16px; line-height: 1.625; }
  .v5-product-price { display: grid; gap: 4px; margin-top: 12px; font-size: 14px; line-height: 1.5; }
  .v5-product-price strong { font-weight: 600; white-space: nowrap; }
  .v5-product-studio { display: grid; gap: 28px; overflow-anchor: none; }
  .v5-product-media { min-width: 0; }
  .v5-photo-composition { position: relative; padding: 0 28px 20px 0; }
  .v5-product-photo { height: auto; aspect-ratio: 4/5; overflow: hidden; background: var(--surface); }
  .v5-product-photo :global(img), .v5-detail-photo :global(img), .v6-flavor-photo :global(img), .v5-related-photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .v5-detail-photo { position: absolute; right: 0; bottom: 0; width: 112px; height: 116px; border: 8px solid var(--paper); background: var(--surface); }
  .v5-product-explorer { min-width: 0; }
  .v5-product-tabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; padding-block: 8px; margin-bottom: 24px; background: var(--paper); }
  .v5-product-tabs button { min-width: 0; min-height: 52px; padding: 12px; border: 1px solid var(--olive-line); border-radius: 4px; background: transparent; color: var(--ink); text-align: left; font: 600 13px/1.45 'Manrope', sans-serif; overflow-wrap: anywhere; cursor: pointer; transition: background-color 160ms var(--ease), color 160ms var(--ease); }
  .v5-product-tabs button[aria-selected='true'] { background: var(--olive); color: var(--on-olive); border-color: var(--olive); }
  .v5-product-tabs button:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .v5-product-panel { padding-block: 8px 28px; scroll-margin-top: var(--header-offset, 128px); min-width: 0; }
  .v5-product-panel + .v5-product-panel { border-top: 1px solid var(--line); padding-top: 32px; }
  .v5-product-explorer.is-ready .v5-product-panel { border: 0; padding-top: 0; }
  .v5-product-panel[hidden], .v5-product-tabs[hidden], .v5-brunch-picker[hidden], .v5-box-composition[hidden] { display: none !important; }
  .v5-product-explorer.is-ready .v5-product-panel:not([hidden]) { animation: v5-panel-reveal 180ms var(--ease); }
  .v5-panel-heading { margin-bottom: 24px; }
  .v5-panel-heading h2 { font-size: 26px; line-height: 1.25; }
  .v5-panel-heading p { margin-top: 12px; max-width: none; color: var(--muted); font-size: 16px; line-height: 1.625; }
  .v5-product-options { display: grid; gap: 12px; list-style: none; margin-top: 24px; }
  .v5-product-options li { display: flex; gap: 12px; font-size: 16px; line-height: 1.625; }
  .v5-product-options strong { font-weight: 600; }
  .v5-product-options li::before { content: ''; width: 16px; height: 1px; flex: none; margin-top: 12px; background: var(--olive-line); }
  .v5-panel-note { max-width: none; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--ink); font-size: 14px; font-weight: 600; line-height: 1.625; }
  .v5-panel-note strong { color: var(--ink); font-weight: 600; }
  .v5-product-prices { width: 100%; border-collapse: collapse; text-align: left; font-size: 16px; line-height: 1.5; }
  .v5-product-prices th { font-weight: 400; }
  .v5-product-prices thead th { padding-bottom: 12px; color: var(--muted); font-size: 13px; }
  .v5-product-prices tbody tr { border-top: 1px solid var(--line); }
  .v5-product-prices tbody th { padding: 12px 16px 12px 0; }
  .v5-product-prices td { padding-block: 12px; text-align: right; font-weight: 600; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .v5-product-prices thead th:last-child { text-align: right; }
  .v5-product-prices small { display: block; margin-top: 4px; color: var(--muted); font-size: 13px; line-height: 1.5; }
  .v6-flavor-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-bottom: 16px; align-items: stretch; }
  .v6-flavor-tabs[hidden], .v6-flavor-group[hidden] { display: none !important; }
  .v6-flavor-tabs button { min-width: 0; min-height: 48px; padding: 8px; border: 1px solid var(--olive-line); border-radius: 4px; background: transparent; color: var(--ink); cursor: pointer; font: 600 13px/1.4 'Manrope', sans-serif; overflow-wrap: normal; }
  .v6-flavor-tabs button[aria-selected='true'] { background: var(--olive); border-color: var(--olive); color: var(--on-olive); }
  .v6-flavor-tabs button:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .v6-flavor-group + .v6-flavor-group { margin-top: 24px; }
  .v6-flavor-group h3 { margin-bottom: 12px; font-size: 20px; }
  .v6-flavor-explorer.is-ready .v6-flavor-group { margin-top: 0; }
  .v6-flavor-explorer.is-ready .v6-flavor-group h3 { display: none; }
  .v6-flavor-photo { height: 156px; overflow: hidden; background: var(--surface); }
  .v6-flavor-group ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 20px; list-style: none; padding-top: 12px; }
  .v6-flavor-group li { padding-block: 8px; border-bottom: 1px solid var(--line); font-size: 16px; line-height: 1.5; }
  .v6-signature-menu { margin: 0; }
  .v6-signature-menu > div { padding-block: 16px; border-bottom: 1px solid var(--line); }
  .v6-signature-menu > div:first-child { padding-top: 0; }
  .v6-signature-menu dt { font: 600 16px/1.5 'Manrope', sans-serif; }
  .v6-signature-menu dd { margin: 4px 0 0; color: var(--muted); font-size: 16px; line-height: 1.625; }
  .v5-brunch-picker { margin-bottom: 24px; }
  .v5-brunch-picker label { display: block; margin-bottom: 8px; font-size: 14px; font-weight: 600; }
  .v5-brunch-select select { width: 100%; min-height: 52px; padding: 12px; border: 1px solid var(--olive-line); border-radius: 4px; background: var(--white); color: var(--ink); font: 400 16px/1.5 'Manrope', sans-serif; cursor: pointer; }
  .v5-brunch-buttons { display: none; }
  .v5-box-composition { padding-block: 8px 24px; }
  .v5-box-composition + .v5-box-composition { border-top: 1px solid var(--line); padding-top: 24px; }
  .v5-brunch.is-ready .v5-box-composition { padding: 0; border: 0; }
  .v5-box-composition header { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
  .v5-box-composition h3 { font: 400 24px/1.25 'Gloock', serif; }
  .v5-box-composition header p { flex: none; text-align: right; font-size: 13px; color: var(--muted); }
  .v5-box-composition header strong { display: block; color: var(--ink); font-size: 20px; font-weight: 400; font-variant-numeric: tabular-nums; }
  .v5-box-menu { display: grid; gap: 16px; padding-top: 20px; }
  .v5-box-menu > div { padding: 16px; background: var(--surface); }
  .v5-box-menu h4 { margin: 0 0 8px; color: var(--ink); font: 400 20px/1.35 'Gloock', serif; }
  .v5-box-menu ul { list-style: none; }
  .v5-box-menu :is(li, p) { margin: 0; padding-block: 8px; color: var(--ink); font-size: 16px; line-height: 1.625; }
  .v5-box-menu li + li { border-top: 1px solid var(--line); }
  .v5-request-plan { display: grid; gap: 20px; }
  .v5-request-plan ul { list-style: none; }
  .v5-request-plan li { padding-block: 10px; border-bottom: 1px solid var(--line); font-size: 16px; line-height: 1.625; }
  .v5-request-plan li:first-child { padding-top: 0; }
  .v5-order-note { margin-top: 24px; max-width: none; color: var(--muted); font-size: 14px; line-height: 1.625; }
  .v5-studio-contact { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px 20px; padding-top: 20px; border-top: 1px solid var(--line); text-align: center; }
  .v5-studio-contact .round-link { width: 100%; justify-content: center; }
