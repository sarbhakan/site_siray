---
import Layout from '../layouts/Layout.astro';
import Photo from './Photo.astro';
import {
  collections, instagram, classicFlavorGroups, signatureFlavors,
  cupcakeFlavors, brunchBoxes, type Collection,
} from '../data/site';

interface Props { item: Collection }
const { item } = Astro.props;
const classic = ['layer-cakes', 'bento-cakes'].includes(item.slug);
const brunch = item.slug === 'brunch-box';
const layer = item.slug === 'layer-cakes';
const cupcakes = item.slug === 'cupcakes';
const related = collections.filter((other) => other.slug !== item.slug).slice(0, 3);
const euro = (value: number) => new Intl.NumberFormat('fr-FR', {
  style: 'currency', currency: 'EUR', maximumFractionDigits: 0,
}).format(value);
const formatLabel = brunch ? 'Les compositions' : classic ? 'Format & décor'
  : item.slug === 'buffets' ? 'Composer le buffet' : 'Formats & tarifs';
const firstPanel = brunch ? 'compositions' : 'formats';
const tabs = [
  { id: firstPanel, label: formatLabel },
  ...(classic || cupcakes ? [{ id: 'saveurs', label: classic ? 'Saveurs classiques' : 'Les saveurs' }] : []),
  ...(layer ? [{ id: 'signatures', label: 'Associations Signature' }] : []),
  { id: 'votre-demande', label: 'Préparer ma demande' },
];
const secondary: Record<string, { image: string; alt: string }> = {
  'layer-cakes': { image: 'gateau-creme', alt: 'Volutes de crème sur un gâteau' },
  'bento-cakes': { image: 'gateau-creme', alt: 'Détail de volutes de crème sur un gâteau' },
  mignardises: { image: 'macarons-rose', alt: 'Macarons roses et ivoire' },
  cupcakes: { image: 'cupcake-detail', alt: 'Cupcake à la crème blanche sur fond sombre' },
  'brunch-box': { image: 'fruits', alt: 'Fraises, myrtilles et oranges' },
  buffets: { image: 'table-reception', alt: 'Table de réception et pâtisseries' },
  plateaux: { image: 'buffet-gourmand', alt: 'Fromages, fruits et bouchées à partager' },
};
const detailPhoto = secondary[item.slug];
const requestPhoto = item.slug === 'bento-cakes'
  ? { image: 'bento-detail', alt: 'Bento cake décoré d’un cœur' }
  : { image: item.image, alt: item.alt };
const flavorImages = [
  { name: 'fruits', alt: 'Fraises, myrtilles et oranges' },
  { name: 'chocolat', alt: 'Chocolat noir, blanc et au lait' },
  { name: 'notes-gourmandes', alt: 'Pistaches dans un bol' },
];
const cupcakeGroups = [
  { name: 'Fruits', flavors: cupcakeFlavors.filter((flavor) => ['Framboise', 'Fraise', 'Fruit de la passion', 'Mangue & fruit de la passion', 'Fruits rouges', 'Lemon curd'].includes(flavor)) },
  { name: 'Chocolats', flavors: cupcakeFlavors.filter((flavor) => flavor === 'Nutella') },
  { name: 'Notes gourmandes', flavors: cupcakeFlavors.filter((flavor) => ['Crème de pistache', 'Crème de spéculoos', 'Caramel beurre salé', 'Crème de noisette'].includes(flavor)) },
];
const flavorGroups = cupcakes ? cupcakeGroups : classicFlavorGroups;
const conciseNotes: Record<string, string> = {
  'layer-cakes': 'Tarif en message privé selon les parts, les saveurs et la personnalisation.',
  'bento-cakes': 'Tarif en message privé selon la personnalisation et le décor.',
  cupcakes: 'Personnalisation spécifique avec supplément.',
  buffets: 'Devis selon les quantités, les produits et la mise en place.',
  plateaux: 'Précisez les convives et la quantité de chaque plateau.',
};
---

<Layout title={item.name} image={item.image} description={`${item.name} sur commande à Bordeaux et en Gironde. ${item.intro}`}>
  <article class="v5-product section-pad">
    <nav class="breadcrumbs" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a><span>/</span><a href="/creations/">Nos prestations</a><span>/</span><span aria-current="page">{item.name}</span>
    </nav>

    <header class="v5-product-heading">
      <h1>{item.name}</h1>
      <div>
        <p class="v5-product-intro">{item.intro}</p>
        {brunch ? (
          <p class="v5-product-price"><span>9 compositions à <strong>30 € / personne</strong></span><span>Anatolia à <strong>35 € / personne</strong></span></p>
        ) : <p class="v5-product-price">{item.priceSummary}</p>}
      </div>
    </header>

    <div class="v5-product-studio">
      <aside class="v5-product-media" aria-label="Inspirations photographiques">
        <div class="v5-photo-composition">
          <div class="v5-product-photo"><Photo name={item.image} alt={item.alt} eager sizes="(min-width: 960px) 42vw, 100vw" /></div>
          <div class="v5-detail-photo"><Photo name={detailPhoto.image} alt={detailPhoto.alt} sizes="(min-width: 960px) 18vw, 35vw" /></div>
        </div>
      </aside>

      <div class="v5-product-explorer" data-v5-tabset>
        <nav class="v5-product-tabs" data-v5-tablist hidden aria-label={`Découvrir les ${item.name.toLowerCase()}`}>
          {tabs.map((tab) => <button type="button" id={`volet-${tab.id}`} data-v5-tab={tab.id}>{tab.label}</button>)}
        </nav>

        <div class="v5-product-panels">
          <section id={firstPanel} class="v5-product-panel" data-v5-panel>
            {brunch ? (
              <>
                <span id="formats"></span>
                <div class="v5-panel-heading"><h2>Dix brunchs au choix</h2><p>Chaque composition réunit du sucré, du salé et un jus de fruits. Les prix sont indiqués par personne.</p></div>
                <div class="v5-brunch" data-v5-brunch>
                  <div class="v5-brunch-picker" data-v5-brunch-controls hidden>
                    <label for="brunch-composition">Choisissez une composition</label>
                    <div class="v5-brunch-select"><select id="brunch-composition" data-v5-brunch-select aria-controls="brunch-details">
                      {brunchBoxes.map((box, index) => <option value={index}>{box.name} — {euro(box.price)} / personne</option>)}
                    </select></div>
                    <div class="v5-brunch-buttons" role="group" aria-label="Choisissez une composition">
                      {brunchBoxes.map((box, index) => <button type="button" data-v5-box-choice={index}><span>{box.name}</span><span>{euro(box.price)}<small>/ personne</small></span></button>)}
                    </div>
                    <p class="sr-only" data-v5-brunch-status role="status"></p>
                  </div>
                  <div id="brunch-details" class="v5-brunch-details">
                    {brunchBoxes.map((box, index) => (
                      <section class="v5-box-composition" data-v5-box={index} aria-labelledby={`brunch-${index}`}>
                        <header><h3 id={`brunch-${index}`}>{box.name}</h3><p><strong>{euro(box.price)}</strong> / personne</p></header>
                        <div class="v5-box-menu"><div><h4>Le sucré</h4><ul>{box.sweet.map((food) => <li>{food}</li>)}</ul></div><div><h4>Le salé</h4><ul>{box.savory.map((food) => <li>{food}</li>)}</ul></div><div class="v5-box-drink"><h4>La boisson</h4><p>{box.drink}</p></div></div>
                      </section>
                    ))}
                  </div>
                </div>
                <p class="v5-panel-note">Précisez le nombre de personnes et l’heure de retrait.</p>
              </>
            ) : (
              <>
                <div class="v5-panel-heading"><h2>{classic ? 'Le format, puis votre décor' : item.slug === 'buffets' ? 'Une table à composer ensemble' : 'Les formats & leurs tarifs'}</h2><p>{item.text}</p></div>
                {item.tariffs.length > 0 && (
                  <table class="v5-product-prices">
                    <caption class="sr-only">Les tarifs des {item.name.toLowerCase()}</caption>
                    <thead><tr><th scope="col">{item.slug === 'plateaux' ? 'Plateau' : 'Quantité'}</th><th scope="col">Tarif</th></tr></thead>
                    <tbody>{item.tariffs.map((tariff) => <tr><th scope="row">{tariff.label}{tariff.detail && <small>{tariff.detail}</small>}</th><td>{euro(tariff.price)}</td></tr>)}</tbody>
                  </table>
                )}
                <ul class="v5-product-options">{item.possibilities.map((possibility, index) => <li>{index === 0 ? <strong>{possibility}</strong> : possibility}</li>)}</ul>
                {item.slug === 'mignardises' ? <p class="v5-panel-note"><strong>Quantités supplémentaires sur devis.</strong> Composition ajustée à vos besoins et au nombre de convives.</p> : <p class="v5-panel-note">{conciseNotes[item.slug] || item.priceNote}</p>}
              </>
            )}
          </section>

          {(classic || cupcakes) && (
            <section id="saveurs" class="v5-product-panel" data-v5-panel>
              <div class="v5-panel-heading"><h2>{cupcakes ? 'Onze saveurs à découvrir' : 'Quinze saveurs classiques'}</h2><p>Choisissez une famille pour retrouver ses saveurs.</p></div>
              <div class="v6-flavor-explorer" data-v6-flavors>
                <nav class="v6-flavor-tabs" data-v6-flavor-controls hidden aria-label="Familles de saveurs">
                  {flavorGroups.map((group, index) => <button type="button" id={`${item.slug}-famille-${index}`} data-v6-flavor-choice={`${item.slug}-saveur-${index}`}>{group.name}</button>)}
                </nav>
                {flavorGroups.map((group, index) => <section id={`${item.slug}-saveur-${index}`} class="v6-flavor-group" data-v6-flavor-panel>
                  <h3>{group.name}</h3>
                  <div class="v6-flavor-photo"><Photo name={flavorImages[index].name} alt={flavorImages[index].alt} sizes="(min-width: 960px) 45vw, 100vw" /></div>
                  <ul>{group.flavors.map((flavor) => <li>{flavor}</li>)}</ul>
                </section>)}
              </div>
              {classic && <p class="v5-panel-note v6-supplement"><strong>Mélange de saveurs : supplément.</strong></p>}
            </section>
          )}

          {layer && (
            <section id="signatures" class="v5-product-panel" data-v5-panel>
              <div class="v5-panel-heading"><h2>Les associations Signature</h2><p>Neuf compositions réservées aux layer cakes.</p></div>
              <div class="v5-signature-intro"><Photo name="framboises" alt="Framboises dans une lumière dorée" sizes="(min-width: 960px) 45vw, 100vw" /></div>
              <dl class="v6-signature-menu">{signatureFlavors.map((flavor) => <div><dt>{flavor.name}</dt><dd>{flavor.composition}</dd></div>)}</dl>
            </section>
          )}

          <section id="votre-demande" class="v5-product-panel" data-v5-panel>
            <div class="v5-panel-heading"><h2>Les détails à nous partager</h2><p>Gardez ces éléments sous la main pour préparer votre message. Nous précisons ensuite votre projet avec vous sur Instagram.</p></div>
            <div class="v5-request-plan"><div class="v5-request-photo"><Photo name={requestPhoto.image} alt={requestPhoto.alt} sizes="(min-width: 960px) 45vw, 100vw" /></div><ul>{item.orderFields.map((field) => <li>{field}</li>)}</ul></div>
            <div class="v5-order-notes"><p><strong>Allergies & intolérances</strong>Signalez-les avant la validation de votre commande, ainsi que toute restriction alimentaire.</p><p>Toutes nos viandes sont halal. Nos créations sont réalisées sur commande.</p><p>Les tarifs peuvent varier selon les personnalisations et demandes spécifiques. Un devis personnalisé est établi lorsque nécessaire.</p></div>
          </section>
        </div>

        <div class="v5-studio-contact">
          <a class="round-link" href={instagram} target="_blank" rel="noopener noreferrer">Écrire sur Instagram</a>
          <div class="v5-studio-practical"><p><strong>Sur commande · Viandes halal</strong></p><a href="/contact/#allergies">Allergies & intolérances</a></div>
        </div>
      </div>
    </div>

    <nav class="v5-related" aria-label="Poursuivre la découverte">
      <div class="v5-related-heading"><h2>À découvrir aussi</h2><a href="/creations/">Toutes les prestations</a></div>
      <div class="v5-related-grid">{related.map((other) => <a class="v5-related-link" href={other.href}><span class="v5-related-photo"><Photo name={other.image} alt={other.alt} sizes="(min-width: 960px) 28vw, 45vw" /></span><span>{other.name}</span><span class="v5-related-action">Découvrir</span></a>)}</div>
    </nav>
  </article>
</Layout>

<script>
  import '../scripts/product-explorer';
</script>

<style>
  .v5-product { padding-bottom: 48px; }
  .v5-product-heading { display: grid; gap: 16px; padding-block: 8px 28px; }
  .v5-product-heading h1 { font-size: var(--title-size); line-height: 1.14; }
  .v5-product-intro { max-width: 52ch; font-size: 16px; line-height: 1.625; }
  .v5-product-price { display: grid; gap: 4px; margin-top: 12px; font-size: 14px; line-height: 1.5; }
  .v5-product-price strong { font-weight: 600; white-space: nowrap; }
  .v5-product-studio { display: grid; gap: 28px; overflow-anchor: none; }
  .v5-product-media { min-width: 0; }
  .v5-photo-composition { position: relative; padding: 0 28px 20px 0; }
  .v5-product-photo { height: 224px; overflow: hidden; background: var(--surface); }
  .v5-product-photo :global(img), .v5-detail-photo :global(img), .v6-flavor-photo :global(img), .v5-signature-intro :global(img), .v5-request-photo :global(img), .v5-related-photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .v5-detail-photo { position: absolute; right: 0; bottom: 0; width: 112px; height: 116px; border: 8px solid var(--paper); background: var(--surface); }
  .v5-product-explorer { min-width: 0; }
  .v5-product-tabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; padding-block: 8px; margin-bottom: 24px; background: var(--paper); }
  .v5-product-tabs button { min-height: 52px; padding: 12px; border: 1px solid var(--olive-line); border-radius: 4px; background: transparent; color: var(--ink); text-align: left; font: 600 13px/1.45 'Manrope', sans-serif; cursor: pointer; transition: background-color 160ms var(--ease), color 160ms var(--ease); }
  .v5-product-tabs button[aria-selected='true'] { background: var(--olive); color: var(--on-olive); border-color: var(--olive); }
  .v5-product-tabs button:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .v5-product-panel { padding-block: 8px 28px; scroll-margin-top: 24px; min-width: 0; }
  .v5-product-panel + .v5-product-panel { border-top: 1px solid var(--line); padding-top: 32px; }
  .v5-product-explorer.is-ready .v5-product-panel { border: 0; padding-top: 0; }
  .v5-product-panel[hidden], .v5-product-tabs[hidden], .v5-brunch-picker[hidden], .v5-box-composition[hidden] { display: none !important; }
  .v5-product-explorer.is-ready .v5-product-panel:not([hidden]) { animation: v5-panel-reveal 180ms var(--ease); }
  .v5-panel-heading { margin-bottom: 24px; }
  .v5-panel-heading h2 { font-size: 26px; line-height: 1.25; }
  .v5-panel-heading p { margin-top: 12px; max-width: 52ch; color: var(--muted); font-size: 16px; line-height: 1.625; }
  .v5-product-options { display: grid; gap: 12px; list-style: none; margin-top: 24px; }
  .v5-product-options li { display: flex; gap: 12px; font-size: 16px; line-height: 1.625; }
  .v5-product-options strong { font-weight: 600; }
  .v5-product-options li::before { content: ''; width: 16px; height: 1px; flex: none; margin-top: 12px; background: var(--olive-line); }
  .v5-panel-note { max-width: none; margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--ink); font-size: 14px; font-weight: 600; line-height: 1.625; }
  .v5-panel-note strong { color: var(--ink); font-weight: 600; }
  .v5-product-prices { width: 100%; border-collapse: collapse; text-align: left; font-size: 16px; line-height: 1.5; }
  .v5-product-prices th { font-weight: 400; }
  .v5-product-prices thead th { padding-bottom: 12px; color: var(--muted); font-size: 13px; }
  .v5-product-prices tbody tr { border-top: 1px solid var(--line); }
  .v5-product-prices tbody th { padding: 12px 16px 12px 0; }
  .v5-product-prices td { padding-block: 12px; text-align: right; font-weight: 600; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .v5-product-prices thead th:last-child { text-align: right; }
  .v5-product-prices small { display: block; margin-top: 4px; color: var(--muted); font-size: 13px; line-height: 1.5; }
  .v5-signature-intro { height: 132px; margin-bottom: 20px; overflow: hidden; background: var(--surface); }
  .v6-flavor-tabs { display: grid; grid-template-columns: 1fr 1fr 1.4fr; gap: 8px; margin-bottom: 16px; }
  .v6-flavor-tabs[hidden], .v6-flavor-group[hidden] { display: none !important; }
  .v6-flavor-tabs button { min-height: 48px; padding: 8px; border: 1px solid var(--olive-line); border-radius: 4px; background: transparent; color: var(--ink); cursor: pointer; font: 600 13px/1.4 'Manrope', sans-serif; }
  .v6-flavor-tabs button[aria-selected='true'] { background: var(--olive); border-color: var(--olive); color: var(--on-olive); }
  .v6-flavor-tabs button:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  .v6-flavor-group + .v6-flavor-group { margin-top: 24px; }
  .v6-flavor-group h3 { margin-bottom: 12px; font-size: 20px; }
  .v6-flavor-explorer.is-ready .v6-flavor-group { margin-top: 0; }
  .v6-flavor-explorer.is-ready .v6-flavor-group h3 { display: none; }
  .v6-flavor-photo { height: 156px; overflow: hidden; background: var(--surface); }
  .v6-flavor-group ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 20px; list-style: none; padding-top: 12px; }
  .v6-flavor-group li { padding-block: 8px; border-bottom: 1px solid var(--line); font-size: 16px; line-height: 1.5; }
  .v6-signature-menu { margin: 0; }
  .v6-signature-menu > div { padding-block: 16px; border-bottom: 1px solid var(--line); }
  .v6-signature-menu > div:first-child { padding-top: 0; }
  .v6-signature-menu dt { font: 600 16px/1.5 'Manrope', sans-serif; }
  .v6-signature-menu dd { margin: 4px 0 0; color: var(--muted); font-size: 16px; line-height: 1.625; }
  .v5-brunch-picker { margin-bottom: 24px; }
  .v5-brunch-picker label { display: block; margin-bottom: 8px; font-size: 14px; font-weight: 600; }
  .v5-brunch-select select { width: 100%; min-height: 52px; padding: 12px; border: 1px solid var(--olive-line); border-radius: 4px; background: var(--white); color: var(--ink); font: 400 16px/1.5 'Manrope', sans-serif; cursor: pointer; }
  .v5-brunch-buttons { display: none; }
  .v5-box-composition { padding-block: 8px 24px; }
  .v5-box-composition + .v5-box-composition { border-top: 1px solid var(--line); padding-top: 24px; }
  .v5-brunch.is-ready .v5-box-composition { padding: 0; border: 0; }
  .v5-box-composition header { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
  .v5-box-composition h3 { font: 400 24px/1.25 'Gloock', serif; }
  .v5-box-composition header p { flex: none; text-align: right; font-size: 13px; color: var(--muted); }
  .v5-box-composition header strong { display: block; color: var(--ink); font-size: 20px; font-weight: 400; font-variant-numeric: tabular-nums; }
  .v5-box-menu { display: grid; gap: 16px; padding-top: 20px; }
  .v5-box-menu > div { padding: 16px; background: var(--surface); }
  .v5-box-menu h4 { margin: 0 0 8px; color: var(--ink); font: 400 20px/1.35 'Gloock', serif; }
  .v5-box-menu ul { list-style: none; }
  .v5-box-menu :is(li, p) { margin: 0; padding-block: 8px; color: var(--ink); font-size: 16px; line-height: 1.625; }
  .v5-box-menu li + li { border-top: 1px solid var(--line); }
  .v5-request-plan { display: grid; gap: 20px; }
  .v5-request-photo { height: 168px; overflow: hidden; background: var(--surface); }
  .v5-request-plan ul { list-style: none; }
  .v5-request-plan li { padding-block: 10px; border-bottom: 1px solid var(--line); font-size: 16px; line-height: 1.625; }
  .v5-request-plan li:first-child { padding-top: 0; }
  .v5-order-notes { display: grid; gap: 16px; margin-top: 24px; }
  .v5-order-notes p { color: var(--muted); font-size: 14px; line-height: 1.625; }
  .v5-order-notes strong { display: block; margin-bottom: 4px; color: var(--ink); font-weight: 600; }
  .v5-studio-contact { padding-top: 24px; border-top: 1px solid var(--line); }
  .v5-studio-contact .round-link { width: 100%; justify-content: center; }
  .v5-studio-contact p { margin-top: 12px; max-width: none; color: var(--ink); font-size: 13px; line-height: 1.5; }
  .v5-studio-practical strong { font-weight: 600; }
  .v5-studio-practical > a { display: inline-flex; align-items: center; min-height: 44px; font-size: 13px; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
  .v5-related { margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--line); }
  .v5-related-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 20px; margin-bottom: 20px; }
  .v5-related-heading h2 { font-size: var(--section-title-size); line-height: 1.25; }
  .v5-related-heading > a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: underline; text-underline-offset: 5px; font-size: 14px; }
  .v5-related-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 16px; }
  .v5-related-link { display: grid; gap: 8px; align-content: start; min-width: 0; }
  .v5-related-photo { display: block; aspect-ratio: 5/4; overflow: hidden; background: var(--surface); }
  .v5-related-link > span:nth-child(2) { font: 400 18px/1.35 'Gloock', serif; }
  .v5-related-action { color: var(--muted); text-decoration: underline; text-underline-offset: 4px; font-size: 13px; }
  .v5-related-link:last-child { grid-column: 1 / -1; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 8px 16px; align-items: end; }
  .v5-related-link:last-child .v5-related-photo { grid-row: 1 / 3; }
  .v5-related-link:last-child .v5-related-action { align-self: start; }
  @keyframes v5-panel-reveal { from { opacity: .35; } to { opacity: 1; } }
  @media (hover: hover) {
    .v5-product-tabs button:not([aria-selected='true']):hover { background: var(--surface); }
    .v6-flavor-tabs button:not([aria-selected='true']):hover { background: var(--surface); }
    .v5-related-link:hover .v5-related-action { color: var(--ink); }
    .v5-brunch-buttons button:hover { background: var(--surface); }
