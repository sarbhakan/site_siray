---
import Photo from './Photo.astro';
import { collections } from '../data/site';

const celebrations = ['layer-cakes', 'bento-cakes', 'cupcakes', 'mignardises']
  .map((slug) => collections.find((item) => item.slug === slug)!);
const gatherings = ['buffets', 'brunch-box', 'plateaux']
  .map((slug) => collections.find((item) => item.slug === slug)!);
---

<section class="collection-edit section-pad" aria-labelledby="collection-edit-title">
  <header class="collection-edit-heading">
    <h2 id="collection-edit-title">La carte Siray</h2>
    <p>Gâteaux personnalisés, douceurs et tables à composer.</p>
    <a class="collection-index-link" href="/creations/">Voir toutes les prestations</a>
  </header>

  <div class="collection-chapter">
    <div class="collection-chapter-heading">
      <h3>Pour célébrer</h3>
      <p>Cakes personnalisés & petites douceurs</p>
    </div>
    <div class="celebration-composition">
      {celebrations.map((item) => (
        <a
          class:list={['collection-piece', `collection-piece--${item.slug}`]}
          href={item.href}
          aria-label={`Découvrir les ${item.name.toLowerCase()}`}
        >
          <div class="collection-piece-photo">
            <Photo
              name={item.image}
              alt={item.alt}
              sizes={item.slug === 'layer-cakes'
                ? '(min-width: 960px) 46vw, 100vw'
                : '(min-width: 960px) 23vw, 45vw'}
            />
          </div>
          <div class="collection-piece-caption">
            <h4>{item.name}</h4>
            <p>{item.short}</p>
            <span class="collection-piece-action">Découvrir</span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <div class="collection-chapter collection-chapter--table">
    <div class="collection-chapter-heading">
      <h3>Pour se retrouver</h3>
      <p>Du brunch à la réception sur mesure</p>
    </div>
    <div class="gathering-composition">
      {gatherings.map((item) => (
        <a
          class:list={['collection-piece', `collection-piece--${item.slug}`]}
          href={item.href}
          aria-label={`Découvrir ${item.slug === 'brunch-box' ? 'les brunch box' : `les ${item.name.toLowerCase()}`}`}
        >
          <div class="collection-piece-photo">
            <Photo
              name={item.image}
              alt={item.alt}
              sizes={item.slug === 'buffets'
                ? '(min-width: 960px) 46vw, 100vw'
                : '(min-width: 960px) 23vw, 45vw'}
            />
          </div>
          <div class="collection-piece-caption">
            <h4>{item.name}</h4>
            <p>{item.short}</p>
            <span class="collection-piece-action">Découvrir</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .collection-edit {
    padding-block: 40px 48px;
  }
  .collection-edit-heading {
    display: grid;
    gap: 12px;
    margin-bottom: 32px;
  }
  .collection-edit-heading h2 {
    font-size: var(--section-title-size);
    line-height: 1.2;
  }
  .collection-edit-heading > p {
    max-width: none;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.625;
  }
  .collection-index-link {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    min-height: 44px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .collection-chapter-heading {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-block: 16px;
    border-top: 1px solid var(--line);
  }
  .collection-chapter-heading h3 {
    font-family: 'Gloock', serif;
    font-size: 22px;
    font-weight: 400;
    line-height: 1.3;
  }
  .collection-chapter-heading p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }
  .celebration-composition,
  .gathering-composition {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 16px;
    align-items: start;
  }
  .collection-piece {
    display: block;
    min-width: 0;
    color: var(--ink);
    text-decoration: none;
  }
  .collection-piece-photo {
    aspect-ratio: 4/5;
    overflow: hidden;
    background: var(--surface);
  }
  .collection-piece-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 280ms var(--ease);
  }
  .collection-piece-caption {
    padding-top: 12px;
  }
  .collection-piece h4 {
    margin: 0;
    font-family: 'Gloock', serif;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.3;
  }
  .collection-piece p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.625;
  }
  .collection-piece-action {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .collection-piece--layer-cakes,
  .collection-piece--mignardises,
  .collection-piece--buffets {
    grid-column: 1/-1;
  }
  .collection-piece--layer-cakes .collection-piece-photo {
    aspect-ratio: 5/4;
  }
  .collection-piece--layer-cakes h4,
  .collection-piece--buffets h4 {
    font-size: 24px;
  }
  .collection-piece--mignardises {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 16px;
    align-items: center;
  }
  .collection-piece--mignardises .collection-piece-photo {
    aspect-ratio: 1;
  }
  .collection-piece--mignardises .collection-piece-caption {
    padding-top: 0;
  }
  .collection-chapter--table {
    margin-top: 32px;
  }
  .collection-piece--buffets .collection-piece-photo {
    aspect-ratio: 16/9;
  }
  .collection-piece--brunch-box .collection-piece-photo,
  .collection-piece--plateaux .collection-piece-photo {
    aspect-ratio: 1;
  }
  @media (hover: hover) {
    .collection-piece:hover .collection-piece-photo :global(img) {
      transform: scale(1.025);
    }
    .collection-piece:hover .collection-piece-action,
    .collection-index-link:hover {
      text-decoration-thickness: 2px;
    }
  }
  @media (min-width: 600px) {
    .collection-edit {
      padding-block: 48px 56px;
    }
    .collection-edit-heading {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 12px 32px;
      align-items: center;
    }
    .collection-edit-heading > p {
      grid-row: 2;
    }
    .collection-index-link {
      grid-column: 2;
      grid-row: 1/3;
    }
    .collection-chapter-heading {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
      gap: 24px;
      padding-block: 20px;
    }
    .celebration-composition,
    .gathering-composition {
      gap: 28px 24px;
    }
    .collection-piece p {
      font-size: 16px;
    }
    .collection-piece h4 {
      font-size: 22px;
    }
    .collection-piece--layer-cakes h4,
    .collection-piece--buffets h4 {
      font-size: 28px;
    }
    .collection-piece--layer-cakes .collection-piece-photo {
      aspect-ratio: 16/10;
    }
    .collection-piece--mignardises {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 24px;
    }
    .collection-piece--mignardises .collection-piece-photo {
      aspect-ratio: 16/9;
    }
  }
  @media (min-width: 960px) {
    .collection-edit {
      padding-block: 64px;
    }
    .collection-edit-heading {
      margin-bottom: 32px;
    }
    .collection-chapter-heading h3 {
      font-size: 24px;
    }
    .celebration-composition,
    .gathering-composition {
      grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr));
      column-gap: 32px;
    }
    .collection-piece--layer-cakes {
      grid-column: 1;
      grid-row: 1/3;
      padding-right: 16px;
    }
    .collection-piece--layer-cakes .collection-piece-photo {
      aspect-ratio: 5/4;
    }
    .collection-piece--bento-cakes .collection-piece-photo,
    .collection-piece--cupcakes .collection-piece-photo {
      aspect-ratio: 4/3;
    }
    .collection-piece--mignardises {
      grid-column: 2/4;
      grid-row: 2;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 24px;
    }
    .collection-piece--mignardises .collection-piece-photo {
      aspect-ratio: 4/3;
    }
    .collection-piece--mignardises h4 {
      font-size: 22px;
    }
    .collection-chapter--table {
      margin-top: 48px;
    }
    .collection-piece--buffets {
      grid-column: 1;
      padding-right: 16px;
    }
    .collection-piece--buffets .collection-piece-photo {
      aspect-ratio: 5/4;
    }
    .collection-piece--brunch-box,
    .collection-piece--plateaux {
      padding-top: 32px;
    }
    .collection-piece--brunch-box .collection-piece-photo,
    .collection-piece--plateaux .collection-piece-photo {
      aspect-ratio: 3/4;
    }
  }
  @media (max-width: 359px) {
    .collection-piece h4 {
      font-size: 18px;
    }
    .collection-piece--layer-cakes h4,
    .collection-piece--buffets h4 {
      font-size: 22px;
    }
    .collection-piece--mignardises {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      gap: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .collection-piece-photo :global(img) {
      transition: none;
    }
    .collection-piece:hover .collection-piece-photo :global(img) {
      transform: none;
    }
  }
</style>
