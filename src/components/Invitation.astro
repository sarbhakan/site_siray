---
import { instagram } from '../data/site';
const { title = 'Votre projet gourmand' } = Astro.props;
---

<section class="invitation section-pad">
  <div class="invitation-top">
    <span>Sur mesure</span>
    <span>Bordeaux & Gironde</span>
  </div>
  <h2>{title}</h2>
  <p>Un cake, une box ou un buffet : échangeons sur votre occasion.</p>
  <a
    class="round-link light"
    href={instagram}
    target="_blank"
    rel="noopener noreferrer"
  >
    <span>Écrire sur Instagram</span>
  </a>
</section>
