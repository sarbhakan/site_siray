---
import { instagram } from '../data/site';
import BrandMark from './BrandMark.astro';

const year = new Date().getFullYear();
const links = [
  { href: '/creations/', label: 'Nos prestations' },
  { href: '/creations/brunch-box/', label: 'Brunch box' },
  { href: '/buffets/', label: 'Buffets' },
  { href: '/plateaux/', label: 'Plateaux' },
  { href: '/galerie/', label: 'Galerie' },
  { href: '/la-maison/', label: 'La maison' },
];
---

<footer class="signature-footer section-pad">
  <div class="signature-footer-contact">
    <h2>Votre projet gourmand</h2>
    <a
      class="signature-footer-instagram"
      href={instagram}
      target="_blank"
      rel="noopener noreferrer"
    >
      Écrire sur Instagram
    </a>
  </div>

  <nav class="signature-footer-nav" aria-label="Explorer Siray Signature">
    {links.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </nav>

  <div class="signature-footer-bottom">
    <a
      class="signature-footer-brand"
      href="/"
      aria-label="Siray Signature, accueil"
    >
      <BrandMark placement="footer" />
    </a>
    <div class="signature-footer-meta">
      <p class="signature-footer-area">Bordeaux & Gironde</p>
      <div class="signature-footer-colophon">
        <p>© {year} Siray Signature</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .signature-footer {
    padding-block: 24px 12px;
    border-top: 1px solid var(--olive-line);
    background: var(--olive);
    color: var(--on-olive);
  }

  .signature-footer :focus-visible {
    outline-color: var(--on-olive);
  }

  .signature-footer-contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .signature-footer-contact h2 {
    font-size: 28px;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .signature-footer-instagram {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
    border-radius: 6px;
    background: var(--paper);
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    line-height: 24px;
    transition: background-color 160ms var(--ease);
  }

  .signature-footer-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 20px;
    margin-block: 8px;
  }

  .signature-footer-nav a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding-block: 8px;
    font-size: 14px;
    line-height: 20px;
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: var(--olive-line);
    text-underline-offset: 5px;
    transition: text-decoration-color 160ms var(--ease);
  }

  .signature-footer-bottom {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 8px;
    border-top: 1px solid var(--olive-line);
  }

  .signature-footer-brand {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    flex: none;
  }

  .signature-footer-brand :global(.brandmark) {
    width: 88px;
  }

  .signature-footer-meta {
    min-width: 0;
    color: var(--on-olive-muted);
    font-size: 13px;
    line-height: 20px;
  }

  .signature-footer-area {
    white-space: nowrap;
  }

  .signature-footer-colophon {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 20px;
  }

  @media (hover: hover) {
    .signature-footer-instagram:hover {
      background: var(--white);
    }

    .signature-footer-nav a:hover {
      text-decoration-color: currentColor;
    }
  }

  @media (min-width: 600px) {
    .signature-footer-contact {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .signature-footer-contact h2 {
      font-size: 32px;
    }

    .signature-footer-instagram {
      flex-shrink: 0;
    }

    .signature-footer-bottom {
      gap: 16px;
    }

    .signature-footer-brand :global(.brandmark) {
      width: 96px;
    }

    .signature-footer-meta {
      display: flex;
      flex: 1;
      flex-wrap: wrap;
      align-items: center;
      gap: 0 24px;
    }
  }

  @media (min-width: 960px) {
    .signature-footer-nav {
      flex-wrap: nowrap;
      gap: 24px;
    }
  }

  @media (max-width: 359px) {
    .signature-footer-contact h2 {
      font-size: 26px;
    }

    .signature-footer-nav {
      column-gap: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signature-footer a {
      transition: none;
    }
  }
</style>
