---
import { collections, instagram } from '../data/site';
import BrandMark from './BrandMark.astro';

const year = new Date().getFullYear();
const siteLinks = [
  { href: '/creations/', label: 'Nos prestations' },
  { href: '/galerie/', label: 'Galerie' },
  { href: '/la-maison/', label: 'La maison' },
  { href: '/contact/', label: 'Votre projet' },
];
---

<footer class="signature-footer section-pad">
  <div class="signature-footer-contact">
    <h2>Votre projet gourmand</h2>
    <a
      class="signature-footer-instagram"
      href={instagram}
      target="_blank"
      rel="noopener noreferrer"
    >
      Écrire sur Instagram
    </a>
  </div>

  <nav class="signature-footer-nav" aria-label="Les sept prestations">
    {collections.map((collection) => (
      <a href={collection.href} data-preview-text={`catalog.collections.${collection.slug}.name`}>{collection.name}</a>
    ))}
  </nav>

  <div class="signature-footer-bottom">
    <a
      class="signature-footer-brand"
      href="/"
      aria-label="Siray Signature, accueil"
    >
      <BrandMark placement="footer" />
    </a>
    <div class="signature-footer-meta">
      <p class="signature-footer-area">Bordeaux & Gironde</p>
      <div class="signature-footer-colophon">
        <p>© {year} Siray Signature</p>
      </div>
    </div>
    <nav class="signature-footer-site" aria-label="Explorer Siray Signature">
      {siteLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
  </div>
</footer>

<style>
  .signature-footer {
    padding-block: 24px 12px;
    border-top: 1px solid var(--olive-line);
    background: var(--olive);
    color: var(--on-olive);
  }

  .signature-footer :focus-visible {
    outline-color: var(--on-olive);
  }

  .signature-footer-contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  .signature-footer-contact h2 {
    font-size: 26px;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .signature-footer-instagram {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
    border-radius: 6px;
    background: var(--paper);
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    line-height: 24px;
    transition: background-color 160ms var(--ease);
  }

  .signature-footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 16px;
    margin-block: 12px 8px;
  }

  .signature-footer-nav a,
  .signature-footer-site a {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    padding-block: 8px;
    font-size: 13px;
    line-height: 20px;
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: var(--olive-line);
    text-underline-offset: 5px;
    transition: text-decoration-color 160ms var(--ease);
  }

  .signature-footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding-top: 8px;
    border-top: 1px solid var(--olive-line);
  }

  .signature-footer-brand {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    flex: none;
  }

  .signature-footer-brand :global(.brandmark) {
    width: 72px;
  }

  .signature-footer-meta {
    min-width: 0;
    flex: 1;
    color: var(--on-olive-muted);
    font-size: 13px;
    line-height: 20px;
  }

  .signature-footer-area {
    white-space: nowrap;
  }

  .signature-footer-colophon {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 20px;
  }

  .signature-footer-site {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    flex-basis: 100%;
    column-gap: 8px;
  }

  .signature-footer-site a {
    color: var(--on-olive-muted);
    font-size: 13px;
  }

  @media (hover: hover) {
    .signature-footer-instagram:hover {
      background: var(--white);
    }

    .signature-footer-nav a:hover,
    .signature-footer-site a:hover {
      text-decoration-color: currentColor;
    }
  }

  @media (min-width: 600px) {
    .signature-footer-contact {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      text-align: left;
    }

    .signature-footer-contact h2 {
      font-size: 32px;
    }

    .signature-footer-instagram {
      flex-shrink: 0;
    }

    .signature-footer-nav {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      column-gap: 24px;
      justify-content: flex-start;
      margin-block: 12px;
    }

    .signature-footer-bottom {
      gap: 16px;
    }

    .signature-footer-brand :global(.brandmark) {
      width: 96px;
    }

    .signature-footer-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0 24px;
    }

    .signature-footer-site {
      display: flex;
      flex-wrap: wrap;
      column-gap: 20px;
      justify-content: flex-start;
    }
  }

  @media (min-width: 960px) {
    .signature-footer-site {
      flex-basis: auto;
      margin-inline-start: auto;
      column-gap: 20px;
    }
  }

  @media (max-width: 359px) {
    .signature-footer-contact h2 {
      font-size: 24px;
    }

    .signature-footer-nav {
      column-gap: 12px;
    }

    .signature-footer-site a {
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signature-footer a {
      transition: none;
    }
  }
</style>
