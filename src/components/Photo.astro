---
import { resolveMedia } from '../lib/media';
import { photoCropStyle, validatePhotoZoom } from '../lib/photo-crop';
interface Props {
  name: string;
  alt: string;
  class?: string;
  eager?: boolean;
  defer?: boolean;
  sizes?: string;
  position?: string;
  zoom?: number;
  native?: boolean;
  sourceOriginal?: boolean;
  previewKey?: string;
}
const {
  name,
  alt,
  class: className,
  eager = false,
  defer = false,
  sizes = '(max-width: 700px) 100vw, 50vw',
  position,
  zoom,
  native = false,
  sourceOriginal = false,
  previewKey,
} = Astro.props;
const media = await resolveMedia(name, { native, sourceOriginal });
const { src, srcset } = media;
const magnification = validatePhotoZoom(zoom);
const transparentPixel =
  'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---

<span data-preview-image={previewKey} data-preview-file={previewKey ? name : undefined} class:list={['siray-photo-crop', { 'siray-photo-crop--zoomed': magnification > 1 }]}>
<img
  src={defer ? transparentPixel : src}
  srcset={defer ? undefined : srcset}
  data-src={defer ? src : undefined}
  data-srcset={defer ? srcset : undefined}
  alt={alt}
  data-source={media.sourceType}
  data-subject={media.category}
  class={className}
  width={media.width}
  height={media.height}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={eager ? 'high' : 'auto'}
  sizes={sizes}
  style={photoCropStyle(position || media.position, magnification)}
/>
</span>

<style>
  /* At 1× the wrapper has no layout box, retaining the original public layout. */
  .siray-photo-crop { display: contents; }
  .siray-photo-crop--zoomed { display: block; width: 100%; height: 100%; overflow: hidden; }
</style>
