---
import credits from '../../docs/image-credits.json';
interface Props {
  name: string;
  alt: string;
  class?: string;
  eager?: boolean;
  sizes?: string;
}
const {
  name,
  alt,
  class: className,
  eager = false,
  sizes = '(max-width: 700px) 100vw, 50vw',
} = Astro.props;
const photo = credits.images.find(
  (item) => item.file === `/images/${name}.webp`,
);
const original = photo?.variants[0];
const srcset = photo?.variants
  .map((item) => `${item.path} ${item.width}w`)
  .join(', ');
---

<img
  src={`/images/${name}.webp`}
  srcset={srcset}
  alt={alt}
  class={className}
  width={original?.width}
  height={original?.height}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={eager ? 'high' : 'auto'}
  sizes={sizes}
  style={photo ? `object-position:${photo.focalPoint}` : undefined}
/>
