---
import credits from '../../docs/image-credits.json';
interface Props {
  name: string;
  alt: string;
  class?: string;
  eager?: boolean;
  defer?: boolean;
  sizes?: string;
  position?: string;
}
const {
  name,
  alt,
  class: className,
  eager = false,
  defer = false,
  sizes = '(max-width: 700px) 100vw, 50vw',
  position,
} = Astro.props;
const photo = credits.images.find(
  (item) => item.file === `/images/${name}.webp`,
);
const original = photo?.variants[0];
const srcset = photo?.variants
  .map((item) => `${item.path} ${item.width}w`)
  .join(', ');
const src = `/images/${name}.webp`;
const transparentPixel =
  'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---

<img
  src={defer ? transparentPixel : src}
  srcset={defer ? undefined : srcset}
  data-src={defer ? src : undefined}
  data-srcset={defer ? srcset : undefined}
  alt={alt}
  data-source={photo?.sourceType || 'stand-in'}
  data-subject={photo?.category}
  class={className}
  width={original?.width}
  height={original?.height}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={eager ? 'high' : 'auto'}
  sizes={sizes}
  style={photo ? `object-position:${position || photo.focalPoint}` : undefined}
/>
