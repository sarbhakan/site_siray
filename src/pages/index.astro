---
import Layout from '../layouts/Layout.astro';
import pages from '../content/pages.json';
import Photo from '../components/Photo.astro';
import CollectionEdit from '../components/CollectionEdit.astro';
import { homeSlides as slides, homePhotos } from '../data/photography';
const page = pages.home;
---

<Layout title={page.pageTitle} home>
  <section class="hero" data-hero aria-label="L’univers Siray Signature">
    <div class="hero-title">
      <div class="hero-copy">
        <h1 data-preview-text="pages.home.title">{page.title}</h1>
        <p class="hero-summary" data-preview-text="pages.home.summary">{page.summary}</p>
        <p class="hero-description" data-preview-text="pages.home.description">
          {page.description}
        </p>
        <a href="/creations/" class="primary-link" data-preview-text="pages.home.discoverLabel">
          {page.discoverLabel}
        </a>
      </div>
      <div class="hero-guide">
        <nav class="hero-paths" aria-label="Explorer selon votre occasion">
          <a href="#pour-celebrer">
            <span class="hero-path-title" data-preview-text="pages.home.celebrateTitle">{page.celebrateTitle}</span>
            <span class="hero-path-detail" data-preview-text="pages.home.celebrateDetail">{page.celebrateDetail}</span>
          </a>
          <a href="#pour-se-retrouver">
            <span class="hero-path-title" data-preview-text="pages.home.gatherTitle">{page.gatherTitle}</span>
            <span class="hero-path-detail" data-preview-text="pages.home.gatherDetail">{page.gatherDetail}</span>
          </a>
        </nav>
        <p class="hero-location"><span data-preview-text="pages.home.location">{page.location}</span><span data-preview-text="pages.home.locationOrderNote">{page.locationOrderNote}</span></p>
      </div>
    </div>
    <div class="hero-visual">
      <button
        class="hero-photos"
        data-preview-each="photography.homeSlides"
        data-slide-surface
        type="button"
        disabled
        aria-label="Figer le défilement des photographies"
        aria-pressed="false"
        aria-describedby="hero-photo-description"
      >
        {slides.map((slide, index) => (
          <span
            class:list={['hero-slide', { 'is-active': index === 0 }]}
            data-slide
            aria-hidden={index !== 0}
          >
            <Photo
              previewKey="."
              name={slide.image}
              alt={slide.alt}
              position={slide.position} zoom={slide.zoom}
              native
              sourceOriginal
              eager={index === 0}
              defer={index !== 0}
              sizes="(min-width: 1167px) 560px, (min-width: 600px) 48vw, 100vw"
            />
          </span>
        ))}
      </button>
      <p id="hero-photo-description" class="sr-only" data-hero-description data-preview-text="photography.homeSlides.0.alt">{slides[0]?.alt}</p>
    </div>
  </section>

  <CollectionEdit />

  <div class="service-note section-pad">
    <p class="service-note-summary"><span data-preview-text="pages.home.orderNote">{page.orderNote}</span> <span aria-hidden="true">·</span> <span data-preview-text="pages.home.halalNote">{page.halalNote}</span></p>
    <a href="/contact/#allergies" data-preview-text="pages.home.allergiesLabel">{page.allergiesLabel}</a>
  </div>

  <section class="maison-feature section-pad">
    <div class="maison-feature-copy">
      <h2 data-preview-text="pages.home.maisonTitle">{page.maisonTitle}</h2>
      <p data-preview-text="pages.home.maisonText">
        {page.maisonText}
      </p>
      <a class="text-link" href="/la-maison/" data-preview-text="pages.home.maisonLink">
        {page.maisonLink}
      </a>
    </div>
    <figure>
      <Photo
        previewKey="photography.homePhotos.maison" name={homePhotos.maison.image}
        alt={homePhotos.maison.alt}
        position={homePhotos.maison.position} zoom={homePhotos.maison.zoom}
      />
    </figure>
  </section>

  <section class="carnet-section section-pad">
    <div class="section-heading">
      <h2 data-preview-text="pages.home.galleryTitle">{page.galleryTitle}</h2>
      <a href="/galerie/" class="text-link" data-preview-text="pages.home.galleryLink">
        {page.galleryLink}
      </a>
    </div>
    <div class="carnet-images">
      <a href="/galerie/#layer-cakes">
        <Photo
          previewKey="photography.homePhotos.cakes" name={homePhotos.cakes.image}
          alt={homePhotos.cakes.alt}
          position={homePhotos.cakes.position} zoom={homePhotos.cakes.zoom}
        />
        <span data-preview-text="pages.home.cakesLabel">{page.cakesLabel}</span>
      </a>
      <a href="/galerie/#cupcakes">
        <Photo
          previewKey="photography.homePhotos.petitesDouceurs" name={homePhotos.petitesDouceurs.image}
          alt={homePhotos.petitesDouceurs.alt}
          position={homePhotos.petitesDouceurs.position} zoom={homePhotos.petitesDouceurs.zoom}
        />
        <span data-preview-text="pages.home.sweetsLabel">{page.sweetsLabel}</span>
      </a>
      <a href="/galerie/#brunch-box">
        <Photo
          previewKey="photography.homePhotos.tables" name={homePhotos.tables.image}
          alt={homePhotos.tables.alt}
          position={homePhotos.tables.position} zoom={homePhotos.tables.zoom}
        />
        <span data-preview-text="pages.home.tablesLabel">{page.tablesLabel}</span>
      </a>
    </div>
  </section>
</Layout>
