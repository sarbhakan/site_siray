---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import CollectionEdit from '../components/CollectionEdit.astro';
import { homeSlides as slides, homePhotos } from '../data/photography';
---

<Layout title="Accueil" home>
  <section class="hero" data-hero aria-label="L’univers Siray Signature">
    <div class="hero-title">
      <div class="hero-copy">
        <h1>Vos instants gourmands</h1>
        <p class="hero-summary">Pâtisserie & tables sur mesure.</p>
        <p class="hero-description">
          Gâteaux personnalisés, brunchs et buffets : choisissez vos saveurs,
          vos couleurs et votre décor.
        </p>
        <a href="/creations/" class="primary-link">
          Découvrir nos prestations
        </a>
      </div>
      <div class="hero-guide">
        <nav class="hero-paths" aria-label="Explorer selon votre occasion">
          <a href="#pour-celebrer">
            <span class="hero-path-title">Pour célébrer</span>
            <span class="hero-path-detail">Layer cakes, bento cakes & cupcakes</span>
          </a>
          <a href="#pour-se-retrouver">
            <span class="hero-path-title">Pour se retrouver</span>
            <span class="hero-path-detail">Mignardises, brunch box, buffets & plateaux</span>
          </a>
        </nav>
        <p class="hero-location"><span>Bordeaux & Gironde</span><span>Créations sur commande</span></p>
      </div>
    </div>
    <div class="hero-visual">
      <button
        class="hero-photos"
        data-slide-surface
        type="button"
        disabled
        aria-label="Figer le défilement des photographies"
        aria-pressed="false"
      >
        {slides.map((slide, index) => (
          <span
            class:list={['hero-slide', { 'is-active': index === 0 }]}
            data-slide
            aria-hidden={index !== 0}
          >
            <Photo
              name={slide.image}
              alt={slide.alt}
              position={slide.position}
              native
              sourceOriginal
              eager={index === 0}
              defer={index !== 0}
              sizes="(min-width: 1167px) 560px, (min-width: 600px) 48vw, 100vw"
            />
          </span>
        ))}
      </button>
    </div>
  </section>

  <CollectionEdit />

  <div class="service-note section-pad">
    <p>Créations sur commande</p>
    <p>Toutes nos viandes sont halal</p>
    <a href="/contact/#allergies">Allergies & intolérances</a>
  </div>

  <section class="maison-feature section-pad">
    <div class="maison-feature-copy">
      <h2>L’art de sublimer vos instants gourmands</h2>
      <p>
        Vos couleurs, votre décor et votre format donnent le ton de vos cakes
        et tables sur mesure.
      </p>
      <a class="text-link" href="/la-maison/">
        L’esprit Siray Signature
      </a>
    </div>
    <figure>
      <Photo
        name={homePhotos.maison.image}
        alt={homePhotos.maison.alt}
      />
    </figure>
  </section>

  <section class="carnet-section section-pad">
    <div class="section-heading">
      <h2>Des idées à garder</h2>
      <a href="/galerie/" class="text-link">
        Ouvrir la galerie
      </a>
    </div>
    <div class="carnet-images">
      <a href="/galerie/#layer-cakes">
        <Photo
          name={homePhotos.cakes.image}
          alt={homePhotos.cakes.alt}
        />
        <span>Cakes</span>
      </a>
      <a href="/galerie/#cupcakes">
        <Photo
          name="cupcakes"
          alt="Cupcakes décorés"
        />
        <span>Petites douceurs</span>
      </a>
      <a href="/galerie/#brunch-box">
        <Photo
          name={homePhotos.tables.image}
          alt={homePhotos.tables.alt}
        />
        <span>Tables & brunchs</span>
      </a>
    </div>
  </section>
</Layout>
