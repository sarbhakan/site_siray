---
import Layout from '../layouts/Layout.astro';
import pages from '../content/pages.json';
import Photo from '../components/Photo.astro';
import CollectionEdit from '../components/CollectionEdit.astro';
import { homeSlides as slides, homePhotos } from '../data/photography';
const page = pages.home;
---

<Layout title={page.pageTitle} home>
  <section class="hero" data-hero aria-label="L’univers Siray Signature">
    <div class="hero-title">
      <div class="hero-copy">
        <h1>{page.title}</h1>
        <p class="hero-summary">{page.summary}</p>
        <p class="hero-description">
          {page.description}
        </p>
        <a href="/creations/" class="primary-link">
          {page.discoverLabel}
        </a>
      </div>
      <div class="hero-guide">
        <nav class="hero-paths" aria-label="Explorer selon votre occasion">
          <a href="#pour-celebrer">
            <span class="hero-path-title">{page.celebrateTitle}</span>
            <span class="hero-path-detail">{page.celebrateDetail}</span>
          </a>
          <a href="#pour-se-retrouver">
            <span class="hero-path-title">{page.gatherTitle}</span>
            <span class="hero-path-detail">{page.gatherDetail}</span>
          </a>
        </nav>
        <p class="hero-location"><span>{page.location}</span><span>{page.locationOrderNote}</span></p>
      </div>
    </div>
    <div class="hero-visual">
      <button
        class="hero-photos"
        data-slide-surface
        type="button"
        disabled
        aria-label="Figer le défilement des photographies"
        aria-pressed="false"
      >
        {slides.map((slide, index) => (
          <span
            class:list={['hero-slide', { 'is-active': index === 0 }]}
            data-slide
            aria-hidden={index !== 0}
          >
            <Photo
              name={slide.image}
              alt={slide.alt}
              position={slide.position}
              native
              sourceOriginal
              eager={index === 0}
              defer={index !== 0}
              sizes="(min-width: 1167px) 560px, (min-width: 600px) 48vw, 100vw"
            />
          </span>
        ))}
      </button>
    </div>
  </section>

  <CollectionEdit />

  <div class="service-note section-pad">
    <p class="service-note-summary">{page.orderNote} <span aria-hidden="true">·</span> {page.halalNote}</p>
    <a href="/contact/#allergies">{page.allergiesLabel}</a>
  </div>

  <section class="maison-feature section-pad">
    <div class="maison-feature-copy">
      <h2>{page.maisonTitle}</h2>
      <p>
        {page.maisonText}
      </p>
      <a class="text-link" href="/la-maison/">
        {page.maisonLink}
      </a>
    </div>
    <figure>
      <Photo
        name={homePhotos.maison.image}
        alt={homePhotos.maison.alt}
        position={homePhotos.maison.position}
      />
    </figure>
  </section>

  <section class="carnet-section section-pad">
    <div class="section-heading">
      <h2>{page.galleryTitle}</h2>
      <a href="/galerie/" class="text-link">
        {page.galleryLink}
      </a>
    </div>
    <div class="carnet-images">
      <a href="/galerie/#layer-cakes">
        <Photo
          name={homePhotos.cakes.image}
          alt={homePhotos.cakes.alt}
          position={homePhotos.cakes.position}
        />
        <span>{page.cakesLabel}</span>
      </a>
      <a href="/galerie/#cupcakes">
        <Photo
          name={homePhotos.petitesDouceurs.image}
          alt={homePhotos.petitesDouceurs.alt}
          position={homePhotos.petitesDouceurs.position}
        />
        <span>{page.sweetsLabel}</span>
      </a>
      <a href="/galerie/#brunch-box">
        <Photo
          name={homePhotos.tables.image}
          alt={homePhotos.tables.alt}
          position={homePhotos.tables.position}
        />
        <span>{page.tablesLabel}</span>
      </a>
    </div>
  </section>
</Layout>
