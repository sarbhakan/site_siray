---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import CollectionEdit from '../components/CollectionEdit.astro';
const slides = [
  {
    image: 'gateau-creme',
    alt: 'Gâteau sur pied décoré de volutes de crème',
  },
  {
    image: 'macarons-ivoire',
    alt: 'Macarons ivoire présentés sur un plat',
  },
  {
    image: 'table-reception',
    alt: 'Table gourmande dressée pour une réception',
  },
];
---

<Layout title="Accueil" home>
  <section class="hero" data-hero aria-label="L’univers Siray Signature">
    <div class="hero-title">
      <h1>Vos instants gourmands</h1>
      <p>Pâtisserie, brunchs et tables sur mesure, à Bordeaux et en Gironde.</p>
      <a href="/creations/" class="primary-link">
        Découvrir nos prestations
      </a>
    </div>
    <div class="hero-visual">
      <button
        class="hero-photos"
        data-slide-surface
        type="button"
        disabled
        aria-label="Figer le défilement des photographies"
        aria-pressed="false"
      >
        {slides.map((slide, index) => (
          <span
            class:list={['hero-slide', { 'is-active': index === 0 }]}
            data-slide
            aria-hidden={index !== 0}
          >
            <Photo
              name={slide.image}
              alt={slide.alt}
              eager={index === 0}
              sizes="(min-width: 960px) 56vw, 100vw"
            />
          </span>
        ))}
      </button>
    </div>
  </section>

  <CollectionEdit />

  <div class="service-note section-pad">
    <p>Créations sur commande</p>
    <p>Toutes nos viandes sont halal</p>
    <a href="/contact/#allergies">Allergies & intolérances : parlons-en</a>
  </div>

  <section class="maison-feature section-pad">
    <div class="maison-feature-copy">
      <h2>L’art de sublimer vos instants gourmands</h2>
      <p>
        Une couleur, un décor, un format. Siray Signature part de vos envies
        pour imaginer vos cakes et vos tables sur mesure.
      </p>
      <a class="text-link" href="/la-maison/">
        L’esprit Siray Signature
      </a>
    </div>
    <figure>
      <Photo
        name="macarons-rose"
        alt="Macarons aux teintes délicates"
      />
    </figure>
  </section>

  <section class="carnet-section section-pad">
    <div class="section-heading">
      <h2>Des idées à garder</h2>
      <a href="/galerie/" class="text-link">
        Ouvrir la galerie
      </a>
    </div>
    <div class="carnet-images">
      <a href="/galerie/#cakes">
        <Photo
          name="layer-cake"
          alt="Gâteau blanc aux fruits rouges"
        />
        <span>Cakes</span>
      </a>
      <a href="/galerie/#douceurs">
        <Photo
          name="cupcakes"
          alt="Cupcakes décorés"
        />
        <span>Petites douceurs</span>
      </a>
      <a href="/galerie/#tables">
        <Photo
          name="brunch"
          alt="Composition de brunch"
        />
        <span>Tables & brunchs</span>
      </a>
    </div>
  </section>
</Layout>
