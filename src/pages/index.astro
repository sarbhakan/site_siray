---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import FormatPanel from '../components/FormatPanel.astro';
import { collections } from '../data/site';
const slides = [
  {
    image: 'gateau-creme',
    alt: 'Gâteau sur pied décoré de volutes de crème, photographie d’ambiance',
  },
  {
    image: 'macarons-ivoire',
    alt: 'Macarons ivoire présentés sur un plat, photographie d’ambiance',
  },
  {
    image: 'table-reception',
    alt: 'Table gourmande dressée pour une réception, photographie d’ambiance',
  },
];
---

<Layout title="Accueil" home>
  <section class="hero" data-hero aria-label="L’univers Siray Signature">
    <div class="hero-title">
      <h1>Vos instants gourmands</h1>
      <p>Cakes, mignardises et buffets sur mesure, à Bordeaux et en Gironde.</p>
      <a href="/creations/" class="primary-link">
        Explorer les créations
      </a>
    </div>
    <div class="hero-visual">
      <button
        class="hero-photos"
        data-slide-surface
        type="button"
        disabled
        aria-label="Figer le défilement des photographies"
        aria-pressed="false"
      >
        {slides.map((slide, index) => (
          <span
            class:list={['hero-slide', { 'is-active': index === 0 }]}
            data-slide
            aria-hidden={index !== 0}
          >
            <Photo
              name={slide.image}
              alt={slide.alt}
              eager={index === 0}
              sizes="(min-width: 960px) 56vw, 100vw"
            />
          </span>
        ))}
      </button>
    </div>
  </section>

  <section class="collection-section section-pad">
    <div class="section-heading">
      <h2>À vous de choisir</h2>
    </div>
    <div
      class="collection-list"
      tabindex="0"
      role="region"
      aria-label="Les créations, défilement horizontal sur mobile"
    >
      {collections.map((item) => (
        <a class="collection-card" href={`/creations/${item.slug}/`}>
          <div class="collection-card-photo">
            {item.slug === 'bento-cakes' ? (
              <FormatPanel />
            ) : (
              <Photo
                name={item.image}
                alt={item.alt}
                sizes="(min-width: 960px) 20vw, 70vw"
              />
            )}
          </div>
          <h3>{item.name}</h3>
          <p>{item.short}</p>
          <span class="card-discover">Découvrir</span>
        </a>
      ))}
      <a class="collection-card" href="/buffets/">
        <div class="collection-card-photo">
          <Photo
            name="plateau-sale"
            alt="Plateau de fromages et de charcuterie, photographie d’ambiance"
            sizes="(min-width: 960px) 20vw, 70vw"
          />
        </div>
        <h3>Buffets & plateaux</h3>
        <p>Sucré, salé, à partager</p>
        <span class="card-discover">Découvrir</span>
      </a>
    </div>
  </section>

  <section class="buffet-feature section-pad">
    <div class="buffet-feature-photo">
      <Photo
        name="buffet-gourmand"
        alt="Table de réception avec compositions gourmandes, photographie d’ambiance"
        sizes="(min-width: 960px) 60vw, 100vw"
      />
    </div>
    <div class="buffet-feature-copy">
      <h2>La table prend toute sa place</h2>
      <p>
        Mignardises, fruits, fromages ou charcuterie : composez votre réception
        autour de ce que vous aimez partager.
      </p>
      <a class="round-link" href="/buffets/">
        Composer un buffet
      </a>
    </div>
  </section>

  <section class="maison-feature section-pad">
    <div class="maison-feature-copy">
      <h2>L’art de sublimer vos instants gourmands</h2>
      <p>
        Une couleur, un décor, un format. Siray Signature part de vos envies
        pour imaginer vos cakes et vos tables sur mesure.
      </p>
      <a class="text-link" href="/la-maison/">
        L’esprit Siray Signature
      </a>
    </div>
    <figure>
      <Photo
        name="macarons-rose"
        alt="Macarons aux teintes délicates, photographie d’ambiance"
      />
    </figure>
  </section>

  <section class="carnet-section section-pad">
    <div class="section-heading">
      <h2>Des idées à garder</h2>
      <a href="/galerie/" class="text-link">
        Parcourir le carnet
      </a>
    </div>
    <div class="carnet-images">
      <a href="/galerie/#cakes">
        <Photo
          name="layer-cake"
          alt="Gâteau blanc aux fruits rouges, photographie d’ambiance"
        />
        <span>Cakes</span>
      </a>
      <a href="/galerie/#douceurs">
        <Photo
          name="cupcakes"
          alt="Cupcakes décorés, photographie d’ambiance"
        />
        <span>Petites douceurs</span>
      </a>
      <a href="/galerie/#tables">
        <Photo
          name="brunch"
          alt="Composition de brunch, photographie d’ambiance"
        />
        <span>Tables & brunchs</span>
      </a>
    </div>
  </section>
</Layout>
