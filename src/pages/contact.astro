---
import Layout from '../layouts/Layout.astro';
import pages from '../content/pages.json';
import { instagram } from '../data/site';

const messageDetails = pages.project.messageDetails;
const page = pages.project;
---

<Layout
  title={page.pageTitle}
  description={page.metaDescription}
>
  <div class="section-pad">
    <nav class="breadcrumbs" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a>
      <span>/</span>
      <span aria-current="page">{page.pageTitle}</span>
    </nav>
  </div>

  <section class="project-intro section-pad" aria-labelledby="project-title">
    <div class="project-opening">
      <h1 id="project-title">{page.title}</h1>
      <p class="project-lead">{page.lead}</p>
      <div class="project-action">
        <a class="primary-link" href={instagram} target="_blank" rel="noopener noreferrer">
          {page.instagramLabel}
        </a>
        <span>{page.instagramHandle}</span>
      </div>
      <p class="project-channel">{page.channel}</p>
      <div class="project-timing">
        <h2>{page.timingTitle}</h2>
        <p>{page.timingLead}{' '}<strong>{page.timingEmphasis}</strong></p>
        <p>{page.timingText}</p>
      </div>
    </div>

    <div class="project-process">
      <h2>{page.processTitle}</h2>
      <ol>
        <li>
          <h3>{page.steps[0].title}</h3>
          <p>{page.steps[0].text}</p>
        </li>
        <li>
          <h3>{page.steps[1].title}</h3>
          <p>{page.steps[1].text}</p>
        </li>
        <li>
          <h3>{page.steps[2].title}</h3>
          <p>{page.steps[2].text}</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="project-practical section-pad" aria-label="Préparer votre demande">
    <div class="project-message">
      <h2>{page.messageTitle}</h2>
      <p>{page.messageIntro}</p>
      <dl>
        {messageDetails.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.text}</dd>
          </div>
        ))}
      </dl>
      <a class="text-link" href="/creations/">{page.exploreLabel}</a>
    </div>

    <div class="project-arrangements">
      <h2>{page.arrangementsTitle}</h2>
      <p class="project-area">{page.area}</p>
      <div class="project-handover">
        <h3>{page.pickupTitle}</h3>
        <p>{page.pickupText}</p>
        <h3>{page.deliveryTitle}</h3>
        <p>{page.deliveryLead}{' '}<strong>{page.deliveryEmphasis}</strong>{' '}{page.deliveryText}</p>
      </div>
      <div class="project-food">
        <h3>{page.foodTitle}</h3>
        <p><strong>{page.foodText}</strong></p>
      </div>
      <details class="project-allergies" id="allergies" open>
        <summary>{page.allergiesTitle}</summary>
        <p>{page.allergiesText}</p>
      </details>
    </div>
  </section>
</Layout>

<style>
  .project-intro,
  .project-practical {
    display: grid;
    gap: 40px;
  }
  .project-intro {
    padding-block: 16px 40px;
  }
  .project-opening h1 {
    max-width: 20ch;
  }
  .project-lead {
    margin-top: 16px;
    max-width: 44ch;
  }
  .project-action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin-top: 24px;
  }
  .project-action span,
  .project-channel {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }
  .project-channel {
    margin-top: 12px;
    max-width: 48ch;
  }
  .project-timing {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .project-timing h2 {
    font-family: 'Manrope', sans-serif;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0;
  }
  .project-timing p {
    margin-top: 8px;
  }
  .project-timing p + p {
    margin-top: 12px;
    color: var(--muted);
  }
  .project-process h2,
  .project-practical h2 {
    font-size: 28px;
    line-height: 1.25;
  }
  .project-process ol {
    list-style: none;
    counter-reset: order-step;
    margin-top: 24px;
  }
  .project-process li {
    position: relative;
    counter-increment: order-step;
    padding: 20px 0 20px 40px;
    border-top: 1px solid var(--line);
  }
  .project-process li::before {
    content: counter(order-step) '.';
    position: absolute;
    inset: 20px auto auto 0;
    color: var(--olive);
    font-size: 18px;
    line-height: 1.4;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .project-process li:last-child {
    padding-bottom: 0;
  }
  .project-process h3,
  .project-handover h3,
  .project-food h3 {
    font-size: 18px;
    line-height: 1.4;
  }
  .project-process p {
    margin-top: 8px;
    color: var(--muted);
  }
  .project-practical {
    padding-block: 40px 48px;
    background: var(--surface);
  }
  .project-message > p {
    margin-top: 12px;
    color: var(--muted);
  }
  .project-message dl {
    margin: 24px 0 8px;
  }
  .project-message dl > div {
    display: grid;
    gap: 4px;
    padding-block: 16px;
    border-top: 1px solid var(--line);
  }
  .project-message dt {
    font-weight: 600;
  }
  .project-message dd {
    margin: 0;
    color: var(--muted);
  }
  .project-area {
    margin-top: 8px;
    color: var(--olive);
    font-weight: 600;
  }
  .project-handover {
    margin-top: 24px;
  }
  .project-handover p {
    margin-top: 8px;
    color: var(--muted);
  }
  .project-handover h3:not(:first-child) {
    margin-top: 24px;
  }
  .project-food {
    margin-top: 24px;
    padding-block: 20px;
    border-block: 1px solid var(--line);
  }
  .project-food p {
    margin-top: 8px;
  }
  .project-allergies {
    margin-top: 8px;
  }
  .project-allergies summary {
    cursor: pointer;
    min-height: 48px;
    padding-block: 12px;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .project-allergies p {
    color: var(--muted);
    padding-bottom: 8px;
  }
  @media (min-width: 600px) {
    .project-message dl > div {
      grid-template-columns: 112px minmax(0, 1fr);
      gap: 16px;
    }
  }
  @media (min-width: 960px) {
    .project-intro,
    .project-practical {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 64px;
    }
    .project-intro {
      padding-block: 24px 56px;
    }
    .project-opening h1 {
      font-size: clamp(36px, 3.5vw, 48px);
    }
    .project-process {
      padding-left: 32px;
      border-left: 1px solid var(--line);
    }
    .project-practical {
      padding-block: 48px 56px;
    }
    .project-arrangements {
      padding-left: 32px;
    }
  }
</style>
