---
import Layout from '../layouts/Layout.astro';
import { instagram } from '../data/site';

const messageDetails = [
  { label: 'La date', text: 'Le jour souhaité et votre occasion.' },
  { label: 'La création', text: 'La prestation, le nombre de personnes ou la quantité.' },
  { label: 'Vos envies', text: 'Les saveurs, couleurs, inscriptions et photos d’inspiration.' },
  { label: 'La remise', text: 'Un retrait sur place ou une demande de livraison, avec le lieu souhaité.' },
  { label: 'À signaler', text: 'Toute allergie, intolérance ou restriction alimentaire.' },
];
---

<Layout
  title="Votre projet"
  description="Préparez votre commande Siray Signature sur Instagram : personnalisation, anticipation, retrait sur place et livraison possible à Bordeaux et en Gironde."
>
  <div class="section-pad">
    <nav class="breadcrumbs" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a>
      <span>/</span>
      <span aria-current="page">Votre projet</span>
    </nav>
  </div>

  <section class="project-intro section-pad" aria-labelledby="project-title">
    <div class="project-opening">
      <h1 id="project-title">Votre projet gourmand</h1>
      <p class="project-lead">Une idée, une date, quelques envies : imaginons votre création ensemble.</p>
      <div class="project-action">
        <a class="primary-link" href={instagram} target="_blank" rel="noopener noreferrer">
          Écrire sur Instagram
        </a>
        <span>@siraysignature</span>
      </div>
      <p class="project-channel">Toutes les commandes se préparent et se confirment sur Instagram.</p>
      <div class="project-timing">
        <h2>Prévoyez à l’avance</h2>
        <p>Contactez-nous dès que votre date est connue, <strong>même pour un bento cake.</strong></p>
        <p>Les demandes pour le jour même ou le lendemain sont difficiles à réaliser. La disponibilité et le délai nécessaire sont confirmés par message.</p>
      </div>
    </div>

    <div class="project-process">
      <h2>De l’idée à la commande</h2>
      <ol>
        <li>
          <h3>Présentez votre envie</h3>
          <p>Envoyez votre date, la prestation souhaitée et le nombre de personnes. Quelques inspirations nous aideront à vous proposer une création adaptée.</p>
        </li>
        <li>
          <h3>Personnalisons les détails</h3>
          <p>Nous précisons ensemble le format, les saveurs et le décor selon la prestation. Le tarif est établi en fonction de votre demande ; les buffets font l’objet d’un devis personnalisé.</p>
        </li>
        <li>
          <h3>Convenons des modalités</h3>
          <p>La disponibilité, le tarif et les modalités de retrait ou de livraison sont convenus sur Instagram avant confirmation de la commande.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="project-practical section-pad" aria-label="Préparer votre demande">
    <div class="project-message">
      <h2>Dans votre premier message</h2>
      <p>Ces quelques renseignements nous permettent de vous répondre plus précisément.</p>
      <dl>
        {messageDetails.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.text}</dd>
          </div>
        ))}
      </dl>
      <a class="text-link" href="/creations/">Explorer les sept prestations</a>
    </div>

    <div class="project-arrangements">
      <h2>Retrait & livraison</h2>
      <p class="project-area">Bordeaux & Gironde</p>
      <div class="project-handover">
        <h3>À récupérer sur place</h3>
        <p>Le retrait se fait généralement sur le lieu de création des prestations. Le lieu et l’horaire sont convenus ensemble sur Instagram.</p>
        <h3>Une livraison à domicile ?</h3>
        <p>Elle peut être envisagée à Bordeaux et en Gironde, <strong>avec un supplément</strong> précisé lors de l’échange. Sa possibilité est à confirmer selon votre demande.</p>
      </div>
      <div class="project-food">
        <h3>Des créations halal</h3>
        <p><strong>Nos viandes et les ingrédients utilisés sont halal.</strong></p>
      </div>
      <details class="project-allergies" id="allergies" open>
        <summary>Allergies & intolérances</summary>
        <p>Signalez-les dès votre premier message. Les ingrédients et les possibilités d’adaptation sont vérifiés ensemble avant confirmation.</p>
      </details>
    </div>
  </section>
</Layout>

<style>
  .project-intro,
  .project-practical {
    display: grid;
    gap: 40px;
  }
  .project-intro {
    padding-block: 16px 40px;
  }
  .project-opening h1 {
    max-width: 20ch;
  }
  .project-lead {
    margin-top: 16px;
    max-width: 44ch;
  }
  .project-action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin-top: 24px;
  }
  .project-action span,
  .project-channel {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
  }
  .project-channel {
    margin-top: 12px;
    max-width: 48ch;
  }
  .project-timing {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .project-timing h2 {
    font-family: 'Manrope', sans-serif;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0;
  }
  .project-timing p {
    margin-top: 8px;
  }
  .project-timing p + p {
    margin-top: 12px;
    color: var(--muted);
  }
  .project-process h2,
  .project-practical h2 {
    font-size: 28px;
    line-height: 1.25;
  }
  .project-process ol {
    list-style: none;
    counter-reset: order-step;
    margin-top: 24px;
  }
  .project-process li {
    position: relative;
    counter-increment: order-step;
    padding: 20px 0 20px 40px;
    border-top: 1px solid var(--line);
  }
  .project-process li::before {
    content: counter(order-step) '.';
    position: absolute;
    inset: 20px auto auto 0;
    color: var(--olive);
    font-size: 18px;
    line-height: 1.4;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .project-process li:last-child {
    padding-bottom: 0;
  }
  .project-process h3,
  .project-handover h3,
  .project-food h3 {
    font-size: 18px;
    line-height: 1.4;
  }
  .project-process p {
    margin-top: 8px;
    color: var(--muted);
  }
  .project-practical {
    padding-block: 40px 48px;
    background: var(--surface);
  }
  .project-message > p {
    margin-top: 12px;
    color: var(--muted);
  }
  .project-message dl {
    margin: 24px 0 8px;
  }
  .project-message dl > div {
    display: grid;
    gap: 4px;
    padding-block: 16px;
    border-top: 1px solid var(--line);
  }
  .project-message dt {
    font-weight: 600;
  }
  .project-message dd {
    margin: 0;
    color: var(--muted);
  }
  .project-area {
    margin-top: 8px;
    color: var(--olive);
    font-weight: 600;
  }
  .project-handover {
    margin-top: 24px;
  }
  .project-handover p {
    margin-top: 8px;
    color: var(--muted);
  }
  .project-handover h3:not(:first-child) {
    margin-top: 24px;
  }
  .project-food {
    margin-top: 24px;
    padding-block: 20px;
    border-block: 1px solid var(--line);
  }
  .project-food p {
    margin-top: 8px;
  }
  .project-allergies {
    margin-top: 8px;
  }
  .project-allergies summary {
    cursor: pointer;
    min-height: 48px;
    padding-block: 12px;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .project-allergies p {
    color: var(--muted);
    padding-bottom: 8px;
  }
  @media (min-width: 600px) {
    .project-message dl > div {
      grid-template-columns: 112px minmax(0, 1fr);
      gap: 16px;
    }
  }
  @media (min-width: 960px) {
    .project-intro,
    .project-practical {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 64px;
    }
    .project-intro {
      padding-block: 24px 56px;
    }
    .project-opening h1 {
      font-size: clamp(36px, 3.5vw, 48px);
    }
    .project-process {
      padding-left: 32px;
      border-left: 1px solid var(--line);
    }
    .project-practical {
      padding-block: 48px 56px;
    }
    .project-arrangements {
      padding-left: 32px;
    }
  }
</style>
