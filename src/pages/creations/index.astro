---
import Layout from '../../layouts/Layout.astro';
import Photo from '../../components/Photo.astro';
import FormatPanel from '../../components/FormatPanel.astro';
import Invitation from '../../components/Invitation.astro';
import { collections } from '../../data/site';
---

<Layout title="Les créations">
  <div class="section-pad">
    <nav class="breadcrumbs" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a>
      <span>/</span>
      <span aria-current="page">Les créations</span>
    </nav>
  </div>
  <section class="page-intro section-pad">
    <h1>Cakes & petites pièces</h1>
    <div class="intro-bottom">
      <p>
        Layer cakes, bentos, mignardises et brunch box sur mesure à Bordeaux et
        en Gironde.
      </p>
      <span class="page-count">4 collections à composer</span>
    </div>
  </section>
  <div class="section-pad">
    {collections.map((item, index) => (
      <article class="collection-editorial">
        <a
          class="editorial-photo"
          href={`/creations/${item.slug}/`}
          aria-label={`Découvrir les ${item.name.toLowerCase()}`}
        >
          {item.slug === 'bento-cakes' ? (
            <FormatPanel />
          ) : (
            <Photo name={item.image} alt={item.alt} eager={index === 0} />
          )}
        </a>
        <div class="editorial-copy">
          <span class="small-label">
            0{index + 1} / {item.occasion}
          </span>
          <h2>{item.name}</h2>
          <p>{item.intro}</p>
          <a class="round-link" href={`/creations/${item.slug}/`}>
            <span>Voir les possibilités</span>
          </a>
        </div>
      </article>
    ))}
  </div>
  <Invitation title="Votre création sur mesure" />
</Layout>
