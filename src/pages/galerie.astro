---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import { gallery } from '../data/site';
import { galleryFilters, homeSlides } from '../data/photography';

const preview = Boolean((Astro.locals as { sirayPreviewPath?: string }).sirayPreviewPath);
// A hidden preview card keeps the list template available even when every
// gallery photo was put in the trash before the last build. Its image must
// come from an active placement, never from a possibly missing trash file.
const previewPhoto = homeSlides[0];
const galleryEntries = gallery.length || !preview || !previewPhoto ? gallery : [{
  ...previewPhoto, label: '', category: 'layer-cakes', categoryLabel: '',
}];
---

<Layout title="La galerie" image={gallery[0]?.image}>
  <div class="section-pad">
    <nav class="breadcrumbs" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a>
      <span>/</span>
      <span aria-current="page">Galerie</span>
    </nav>
  </div>
  <section class="page-intro section-pad">
    <h1>La galerie</h1>
    <div class="intro-bottom">
      <p>
        Gâteaux, petites pièces et tables à partager.
      </p>
    </div>
  </section>
  <section
    class="section-pad"
    data-gallery
    aria-label="Galerie de photographies"
  >
    <div class="gallery-controls" hidden={gallery.length === 0} data-preview-visible="photography.gallery">
      <div
        class="gallery-filters"
        role="group"
        aria-label="Filtrer les photographies"
      >
        {galleryFilters.map((filter) => (
          <button type="button" class="gallery-filter" data-filter={filter.id} aria-pressed={filter.id === 'all'}>
            {filter.label}
          </button>
        ))}
      </div>
      <span class="gallery-status" aria-live="polite">
        {gallery.length} photographies
      </span>
    </div>
    <p hidden={gallery.length > 0} data-preview-visible="photography.galleryEmpty">
      Aucune photo n’est présentée pour le moment. <a class="text-link" href="/creations/">Découvrir nos prestations</a>
    </p>
    <div class="gallery-grid" hidden={gallery.length === 0} data-preview-visible="photography.gallery" data-preview-each="photography.gallery">
      {galleryEntries.map((photo, index) => (
        <figure class="gallery-card" hidden={gallery.length === 0} data-category={photo.category} data-preview-attr-data-category=".category">
          <div class="gallery-photo">
            <Photo
              previewKey="." name={photo.image}
              alt={photo.alt}
              position={photo.position} zoom={photo.zoom}
              eager={index < 2}
              sizes="(min-width: 1200px) 25vw, (min-width: 700px) 33vw, 50vw"
            />
          </div>
          <figcaption>
            <span data-preview-text=".label">{photo.label}</span>
            <span data-preview-text=".categoryLabel">{photo.categoryLabel}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
</Layout>
