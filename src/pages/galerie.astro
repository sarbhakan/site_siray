---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import { gallery } from '../data/site';
---

<Layout title="La galerie" image="macarons-rose">
  <div class="section-pad">
    <nav class="breadcrumbs" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a>
      <span>/</span>
      <span aria-current="page">Galerie</span>
    </nav>
  </div>
  <section class="page-intro section-pad">
    <h1>La galerie</h1>
    <div class="intro-bottom">
      <p>
        Gâteaux, petites pièces et tables à partager.
      </p>
    </div>
  </section>
  <section
    class="section-pad"
    data-gallery
    aria-label="Galerie de photographies"
  >
    <div class="gallery-controls">
      <div
        class="gallery-filters"
        role="group"
        aria-label="Filtrer les photographies"
      >
        <button type="button" class="gallery-filter" data-filter="all" aria-pressed="true">
          Tout voir
        </button>
        <button type="button" class="gallery-filter" data-filter="cakes" aria-pressed="false">
          Cakes
        </button>
        <button
          type="button"
          class="gallery-filter"
          data-filter="douceurs"
          aria-pressed="false"
        >
          Douceurs
        </button>
        <button
          type="button"
          class="gallery-filter"
          data-filter="tables"
          aria-pressed="false"
        >
          Tables
        </button>
      </div>
      <span class="gallery-status" aria-live="polite">
        {gallery.length} photographies
      </span>
    </div>
    <div class="gallery-grid">
      {gallery.map((photo, index) => (
        <figure class="gallery-card" data-category={photo.category}>
          <div class="gallery-photo">
            <Photo
              name={photo.image}
              alt={photo.alt}
              eager={index < 2}
              sizes="(min-width: 1200px) 25vw, (min-width: 700px) 33vw, 50vw"
            />
          </div>
          <figcaption>
            <span>{photo.label}</span>
            <span>{photo.categoryLabel}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
</Layout>
