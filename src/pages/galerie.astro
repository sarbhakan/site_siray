---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Invitation from '../components/Invitation.astro';
import { gallery } from '../data/site';
---

<Layout title="Le carnet des envies" image="macarons-rose">
  <div class="section-pad">
    <nav class="breadcrumbs" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a>
      <span>/</span>
      <span aria-current="page">Le carnet</span>
    </nav>
  </div>
  <section class="page-intro section-pad">
    <h1>
      Le carnet
      <br />
      des envies.
    </h1>
    <div class="intro-bottom">
      <p>
        Des matières, des couleurs, des tables. Quelques images d’ambiance pour
        commencer à imaginer votre prochain moment gourmand.
      </p>
    </div>
  </section>
  <section
    class="section-pad"
    data-gallery
    aria-label="Photographies d’ambiance"
  >
    <div class="gallery-controls">
      <div
        class="gallery-filters"
        role="group"
        aria-label="Filtrer les photographies"
      >
        <button class="gallery-filter" data-filter="all" aria-pressed="true">
          Tout voir
        </button>
        <button class="gallery-filter" data-filter="cakes" aria-pressed="false">
          Cakes
        </button>
        <button
          class="gallery-filter"
          data-filter="douceurs"
          aria-pressed="false"
        >
          Douceurs
        </button>
        <button
          class="gallery-filter"
          data-filter="tables"
          aria-pressed="false"
        >
          Tables
        </button>
      </div>
      <span class="gallery-status" aria-live="polite">
        8 photographies
      </span>
    </div>
    <div class="gallery-grid">
      {gallery.map((photo, index) => (
        <figure class="gallery-card" data-category={photo.category}>
          <a
            href={`/images/${photo.image}.webp`}
            class="gallery-photo"
            data-lightbox-index={index}
            data-image={`/images/${photo.image}.webp`}
            data-caption={photo.label}
            aria-label={`Agrandir : ${photo.alt}`}
          >
            <Photo
              name={photo.image}
              alt={`${photo.alt}, photographie d’ambiance`}
              eager={index < 2}
              sizes="(max-width: 700px) 50vw, 33vw"
            />
            <span>
              <Icon name="plus" />
            </span>
          </a>
          <figcaption>
            <span>{photo.label}</span>
            <span>{photo.categoryLabel}</span>
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="gallery-disclaimer">
      Ce carnet présente des photographies d’ambiance, et non des réalisations
      Siray Signature. Nos propres créations prendront bientôt leur place ici.{' '}
      <a class="text-link" href="/credits/">
        Voir les crédits <Icon />
      </a>
    </p>
  </section>
  <dialog class="lightbox" aria-label="Photographie agrandie">
    <div class="lightbox-top">
      <span>Le carnet · Photographie d’ambiance</span>
      <button
        class="icon-button"
        data-lightbox-close
        aria-label="Fermer la photographie"
      >
        <Icon name="close" />
      </button>
    </div>
    <figure class="lightbox-figure">
      <img src="/images/layer-cake.webp" alt="" width="1600" height="2000" />
    </figure>
    <div class="lightbox-bottom">
      <span class="lightbox-caption" aria-live="polite"></span>
      <div class="lightbox-arrows">
        <button
          class="icon-button"
          data-lightbox-prev
          aria-label="Photographie précédente"
        >
          <Icon class="reverse" />
        </button>
        <button
          class="icon-button"
          data-lightbox-next
          aria-label="Photographie suivante"
        >
          <Icon />
        </button>
      </div>
    </div>
  </dialog>
  <Invitation />
</Layout>
