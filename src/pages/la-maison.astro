---
import Layout from '../layouts/Layout.astro';
import pages from '../content/pages.json';
import Photo from '../components/Photo.astro';
import { homePhotos } from '../data/photography';

const cakePhoto = homePhotos.maisonCake;
const tablePhoto = homePhotos.maisonTable;
const page = pages.maison;
---

<Layout title={page.pageTitle} image={cakePhoto.image}>
  <div class="section-pad">
    <nav class="breadcrumbs" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a>
      <span>/</span>
      <span aria-current="page" data-preview-text="pages.maison.pageTitle">{page.pageTitle}</span>
    </nav>
  </div>
  <section class="page-intro section-pad">
    <h1 data-preview-text="pages.maison.title">{page.title}</h1>
    <div class="intro-bottom">
      <p data-preview-text="pages.maison.intro">{page.intro}</p>
    </div>
  </section>

  <section class="maison-editorial section-pad" aria-labelledby="maison-world-title">
    <figure class="maison-portrait">
      <Photo previewKey="photography.homePhotos.maisonCake" name={cakePhoto.image} alt={cakePhoto.alt} eager sizes="(min-width: 960px) 42vw, (min-width: 600px) 46vw, 100vw" position={cakePhoto.position} zoom={cakePhoto.zoom} />
    </figure>
    <div class="maison-copy">
      <h2 id="maison-world-title" data-preview-text="pages.maison.worldTitle">{page.worldTitle}</h2>
      <p data-preview-text="pages.maison.worldText">
        {page.worldText}
      </p>
      <div class="maison-focus">
        <h3 data-preview-text="pages.maison.pastryTitle">{page.pastryTitle}</h3>
        <p data-preview-text="pages.maison.pastryText">
          {page.pastryText}
        </p>
      </div>
      <div class="maison-focus">
        <h3 data-preview-text="pages.maison.sharingTitle">{page.sharingTitle}</h3>
        <p data-preview-text="pages.maison.sharingText">
          {page.sharingText}
        </p>
      </div>
    </div>
  </section>

  <section class="maison-bespoke section-pad" aria-labelledby="maison-bespoke-title">
    <div class="maison-copy">
      <h2 id="maison-bespoke-title" data-preview-text="pages.maison.bespokeTitle">{page.bespokeTitle}</h2>
      <p data-preview-text="pages.maison.bespokeText">
        {page.bespokeText}
      </p>
      <p>
        <span data-preview-text="pages.maison.exploreBefore">{page.exploreBefore}</span>{' '}<a class="maison-inline-link" href="/creations/" data-preview-text="pages.maison.exploreLink">{page.exploreLink}</a>{' '}<span data-preview-text="pages.maison.exploreAfter">{page.exploreAfter}</span>
      </p>
      <p data-preview-text="pages.maison.orderingText">
        {page.orderingText}
      </p>
      <p class="maison-practical" data-preview-text="pages.maison.practicalText">
        {page.practicalText}
      </p>
    </div>
    <figure class="maison-portrait maison-portrait--table">
      <Photo previewKey="photography.homePhotos.maisonTable" name={tablePhoto.image} alt={tablePhoto.alt} sizes="(min-width: 960px) 32vw, (min-width: 600px) 36vw, 100vw" position={tablePhoto.position} zoom={tablePhoto.zoom} />
    </figure>
  </section>
</Layout>

<style>
  .maison-editorial,
  .maison-bespoke {
    display: grid;
    align-items: start;
    gap: 28px;
    padding-block: 8px 40px;
  }

  .maison-portrait {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--surface);
  }

  .maison-portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .maison-copy {
    min-width: 0;
  }

  .maison-copy h2 {
    font-size: var(--section-title-size);
    line-height: 1.2;
    text-wrap: balance;
  }

  .maison-copy p {
    margin-top: 16px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.625;
  }

  .maison-focus {
    margin-top: 24px;
  }

  .maison-focus h3 {
    font-family: 'Gloock', serif;
    font-size: 22px;
    font-weight: 400;
    line-height: 1.3;
  }

  .maison-focus p {
    margin-top: 8px;
  }

  .maison-bespoke {
    padding-block: 32px 40px;
    background: var(--surface);
  }

  .maison-inline-link {
    display: inline;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .maison-inline-link:hover {
    text-decoration-thickness: 2px;
  }

  .maison-copy .maison-practical {
    padding-top: 16px;
    border-top: 1px solid var(--line);
    color: var(--ink);
    font-weight: 600;
  }

  @media (min-width: 600px) {
    .maison-editorial {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
      gap: 32px;
    }

    .maison-bespoke {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.7fr);
      gap: 32px;
      padding-block: 40px;
    }
  }

  @media (min-width: 960px) {
    .maison-editorial {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
      align-items: center;
      gap: 64px;
      padding-block: 8px 64px;
    }

    .maison-bespoke {
      align-items: center;
      gap: 80px;
      padding-block: 56px;
    }

    .maison-focus {
      margin-top: 32px;
    }
  }
</style>
