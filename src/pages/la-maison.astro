---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import { photo } from '../data/photography';

const cakePhoto = photo('layer-fleurs');
const tablePhoto = photo('plateau-grazing');
---

<Layout title="La maison" image={cakePhoto.image}>
  <div class="section-pad">
    <nav class="breadcrumbs" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a>
      <span>/</span>
      <span aria-current="page">La maison</span>
    </nav>
  </div>
  <section class="page-intro section-pad">
    <h1>La maison Siray</h1>
    <div class="intro-bottom">
      <p>Cakes, mignardises et buffets sur mesure, à Bordeaux et en Gironde.</p>
      <span class="page-count">Bordeaux & Gironde</span>
    </div>
  </section>

  <section class="maison-editorial section-pad" aria-labelledby="maison-world-title">
    <figure class="maison-portrait">
      <Photo name={cakePhoto.image} alt={cakePhoto.alt} eager sizes="(min-width: 960px) 42vw, (min-width: 600px) 46vw, 100vw" position="50% 50%" />
    </figure>
    <div class="maison-copy">
      <h2 id="maison-world-title">L’art de sublimer vos instants gourmands</h2>
      <p>
        Un gâteau imaginé pour une occasion, un brunch à partager, une table
        dressée pour recevoir : Siray Signature accompagne vos moments gourmands
        avec des créations à composer selon vos envies.
      </p>
      <div class="maison-focus">
        <h3>La pâtisserie, à votre image</h3>
        <p>
          Layer cakes, bento cakes et cupcakes se déclinent en saveurs, couleurs
          et décors. D’une petite attention au gâteau de célébration, le format
          et la présentation donnent le ton de votre occasion.
        </p>
      </div>
      <div class="maison-focus">
        <h3>Le plaisir de partager</h3>
        <p>
          Mignardises sucrées ou salées, brunch box et plateaux se retrouvent
          autour de la table. Pour une réception, le buffet associe les bouchées
          à une mise en scène personnalisée : supports, couleurs et décoration
          s’accordent à votre thème.
        </p>
      </div>
    </div>
  </section>

  <section class="maison-bespoke section-pad" aria-labelledby="maison-bespoke-title">
    <div class="maison-copy">
      <h2 id="maison-bespoke-title">Le sur-mesure, ensemble</h2>
      <p>
        Votre thème, les couleurs de votre table ou une photo d’inspiration
        peuvent servir de point de départ. Nous échangeons sur votre idée pour
        préciser le format, les saveurs, le décor et la présentation.
      </p>
      <p>
        Explorez <a class="maison-inline-link" href="/creations/">nos prestations</a>
        pour découvrir les sept familles, leurs compositions et leurs tarifs.
        Les options et les informations à transmettre sont réunies dans chaque fiche.
      </p>
      <p>
        Les demandes et les commandes se préparent sur Instagram. Indiquez votre
        date, le nombre de personnes et vos inspirations pour que nous puissions
        échanger sur votre projet à Bordeaux ou en Gironde.
      </p>
      <p class="maison-practical">
        Toutes nos viandes sont halal. Signalez vos allergies et intolérances
        lors de votre demande, avant la confirmation de la commande.
      </p>
    </div>
    <figure class="maison-portrait maison-portrait--table">
      <Photo name={tablePhoto.image} alt={tablePhoto.alt} sizes="(min-width: 960px) 32vw, (min-width: 600px) 36vw, 100vw" position="50% 50%" />
    </figure>
  </section>
</Layout>

<style>
  .maison-editorial,
  .maison-bespoke {
    display: grid;
    align-items: start;
    gap: 28px;
    padding-block: 8px 40px;
  }

  .maison-portrait {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--surface);
  }

  .maison-portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .maison-copy {
    min-width: 0;
  }

  .maison-copy h2 {
    font-size: var(--section-title-size);
    line-height: 1.2;
    text-wrap: balance;
  }

  .maison-copy p {
    margin-top: 16px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.625;
  }

  .maison-focus {
    margin-top: 24px;
  }

  .maison-focus h3 {
    font-family: 'Gloock', serif;
    font-size: 22px;
    font-weight: 400;
    line-height: 1.3;
  }

  .maison-focus p {
    margin-top: 8px;
  }

  .maison-bespoke {
    padding-block: 32px 40px;
    background: var(--surface);
  }

  .maison-inline-link {
    display: inline;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .maison-inline-link:hover {
    text-decoration-thickness: 2px;
  }

  .maison-copy .maison-practical {
    padding-top: 16px;
    border-top: 1px solid var(--line);
    color: var(--ink);
    font-weight: 600;
  }

  @media (min-width: 600px) {
    .maison-editorial {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
      gap: 32px;
    }

    .maison-bespoke {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.7fr);
      gap: 32px;
      padding-block: 40px;
    }
  }

  @media (min-width: 960px) {
    .maison-editorial {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
      align-items: center;
      gap: 64px;
      padding-block: 8px 64px;
    }

    .maison-bespoke {
      align-items: center;
      gap: 80px;
      padding-block: 56px;
    }

    .maison-focus {
      margin-top: 32px;
    }
  }
</style>
