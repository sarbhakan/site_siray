---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
---

<Layout title="La maison" image="macarons-ivoire">
  <div class="section-pad">
    <nav class="breadcrumbs" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a>
      <span>/</span>
      <span aria-current="page">La maison</span>
    </nav>
  </div>
  <section class="page-intro section-pad">
    <h1>La maison Siray</h1>
    <div class="intro-bottom">
      <p>
        Cakes, mignardises et buffets sur mesure pour vos occasions, à Bordeaux
        et en Gironde.
      </p>
      <span class="page-count">Bordeaux & Gironde</span>
    </div>
  </section>
  <div class="wide-photo">
    <Photo
      name="macarons-ivoire"
      alt="Macarons ivoire et détails de table"
      eager
      sizes="100vw"
    />
  </div>
  <section class="house-statement section-pad">
    <h2>Le sur-mesure, ensemble</h2>
    <div>
      <p>
        Votre thème, les couleurs de votre table ou une photo d’inspiration
        peuvent servir de point de départ. Nous échangeons sur votre idée pour
        définir la composition.
      </p>
      <p>
        Du bento cake au buffet, choisissez un format selon votre occasion et le
        nombre de personnes. Saveurs, décor et présentation se discutent ensuite
        sur Instagram.
      </p>
      <p>
        Nos sept familles se découvrent dans{' '}
        <a class="text-link" href="/creations/">
          nos prestations
        </a>
        , avec leurs compositions, leurs saveurs et leurs tarifs. Les
        personnalisations se précisent pendant notre échange.
      </p>
    </div>
  </section>
  <section class="house-quote section-pad">
    <p>L’art de sublimer vos instants gourmands</p>
    <span>Siray Signature</span>
  </section>
</Layout>
