---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Process from '../components/Process.astro';
import Invitation from '../components/Invitation.astro';
---

<Layout
  title="Buffets & réceptions"
  image="buffet-gourmand"
  description="Buffets sucrés et salés, mignardises, plateaux de fruits, fromages et charcuterie sur mesure à Bordeaux et en Gironde."
>
  <section class="buffet-intro section-pad">
    <nav class="breadcrumbs" aria-label="Fil d’Ariane">
      <a href="/">Accueil</a>
      <span>/</span>
      <span aria-current="page">Buffets & réceptions</span>
    </nav>
    <h1>Buffets sur mesure</h1>
    <p>
      Buffets sucrés et salés, plateaux de fruits, fromages et charcuterie. Des
      compositions à partager, à Bordeaux et en Gironde.
    </p>
  </section>
  <div class="wide-photo">
    <Photo
      name="buffet-gourmand"
      alt="Buffet dressé pour une réception, photographie d’ambiance"
      eager
      sizes="100vw"
    />
  </div>
  <section class="buffet-types section-pad">
    <article>
      <figure>
        <Photo
          name="table-reception"
          alt="Table sucrée de réception, photographie d’ambiance"
        />
      </figure>
      <h2>Les pièces sucrées</h2>
      <p>
        Mignardises, cupcakes et cakes peuvent se réunir sur une même table.
        Choisissons les formats et la présentation pour votre réception.
      </p>
      <ul>
        <li>Mignardises & petites pièces sucrées</li>
        <li>Cupcakes & cakes à personnaliser</li>
        <li>Une présentation accordée à votre occasion</li>
      </ul>
    </article>
    <article>
      <figure>
        <Photo
          name="plateau-sale"
          alt="Plateau de fromages et charcuterie, photographie d’ambiance"
        />
      </figure>
      <h2>Les plateaux à partager</h2>
      <p>
        Fruits, fromages et charcuterie composent vos plateaux. Le sucré et le
        salé peuvent aussi se retrouver dans une formule brunch.
      </p>
      <ul>
        <li>Plateaux de fruits</li>
        <li>Fromages & charcuterie</li>
        <li>Brunch & compositions sucrées-salées</li>
      </ul>
    </article>
  </section>
  <div class="section-pad">
    <div class="detail-occasion">
      <span>Réceptions privées, anniversaires et moments à partager</span>
      <span>Bordeaux & Gironde</span>
    </div>
  </div>
  <Process />
  <Invitation title="Votre buffet, à composer ensemble" />
</Layout>
