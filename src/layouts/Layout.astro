---
import { ClientRouter } from 'astro:transitions';
import Icon from '../components/Icon.astro';
import Footer from '../components/Footer.astro';
import BrandMark from '../components/BrandMark.astro';
import { collections, instagram } from '../data/site';
import { collectionPhotography } from '../data/photography';
import { resolveMedia } from '../lib/media';
import '@fontsource/gloock/latin-400.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-ext-400.css';
import '@fontsource/manrope/latin-ext-600.css';
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
  image?: string;
  home?: boolean;
}
const {
  title,
  description = 'Layer cakes, bento cakes, mignardises, cupcakes, brunch box, buffets et plateaux sur commande à Bordeaux et en Gironde. Siray Signature.',
  image = collectionPhotography['layer-cakes'].cover.image,
  home = false,
} = Astro.props;
const socialImage = await resolveMedia(image);
const pathname = Astro.url.pathname;
const links = [
  { href: '/galerie/', label: 'Galerie' },
  { href: '/la-maison/', label: 'La maison' },
];
const inCatalog =
  pathname.startsWith('/creations/') ||
  pathname === '/buffets/' ||
  pathname === '/plateaux/';
const canonical = Astro.site ? new URL(pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#4e533d" />
    <meta name="description" content={description} />
    <title>{title === 'Accueil' ? 'Siray Signature — Vos instants gourmands, Bordeaux' : `${title} — Siray Signature`}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={`${title} — Siray Signature`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:image"
      content={
        Astro.site ? new URL(socialImage.src, Astro.site).href : socialImage.src
      }
    />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
  </head>
  <body class:list={[{ 'home-page': home }]}>
    <a href="#contenu" class="skip-link">
      Aller au contenu
    </a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Siray Signature, accueil">
        <BrandMark placement="header" />
      </a>
      <nav class="desktop-nav" aria-label="Navigation principale">
        <details class="catalog-menu" data-catalog-menu>
          <summary class:list={{ 'is-current': inCatalog }}>
            Nos prestations
          </summary>
          <div class="catalog-dropdown">
            <a href="/creations/">Toutes les prestations</a>
            {collections.map((item) => (
              <a
                href={item.href}
                aria-current={pathname === item.href ? 'page' : undefined}
              >
                {item.name}
              </a>
            ))}
          </div>
        </details>
        {links.map((link) => (
          <a
            href={link.href}
            aria-current={pathname.startsWith(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>
      <a class="header-contact" href="/contact/">
        Votre projet
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span>Menu</span>
        <span class="menu-lines" aria-hidden="true">
          <i></i>
          <i></i>
        </span>
      </button>
    </header>
    <dialog id="mobile-menu" class="mobile-menu" aria-label="Navigation">
      <div class="mobile-menu-top">
        <a href="/" class="brand" aria-label="Siray Signature, accueil">
          <BrandMark placement="menu" />
        </a>
        <button class="menu-close" type="button" data-close-menu autofocus>
          <span>Fermer</span>
          <Icon name="close" />
        </button>
      </div>
      <nav aria-label="Navigation mobile">
        <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>Accueil</a>
        <a href="/creations/" aria-current={pathname === '/creations/' ? 'page' : undefined}>Nos prestations</a>
        <div class="mobile-catalog">
          {collections.map((item) => (
            <a
              href={item.href}
              aria-current={pathname === item.href ? 'page' : undefined}
            >
              {item.name}
            </a>
          ))}
        </div>
        {links.map((link) => (
          <a
            href={link.href}
            aria-current={pathname.startsWith(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
        <a href="/contact/" aria-current={pathname === '/contact/' ? 'page' : undefined}>Votre projet</a>
      </nav>
      <div class="mobile-menu-bottom">
      <a
        class="menu-instagram"
        href={instagram}
        target="_blank"
        rel="noopener noreferrer"
      >
        @siraysignature
      </a>
      <p>Bordeaux & Gironde</p>
      </div>
    </dialog>
    <noscript>
      <nav class="no-script-nav" aria-label="Navigation sans JavaScript">
        <a href="/creations/">Nos prestations</a>
        {collections.map((item) => (
          <a href={item.href}>{item.name}</a>
        ))}
        {links.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
        <a href="/contact/">Votre projet</a>
      </nav>
    </noscript>
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
